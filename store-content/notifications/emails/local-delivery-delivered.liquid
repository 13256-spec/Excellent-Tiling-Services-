{% comment %} ETS block for: Local delivery: delivered {% endcomment %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:20px 0;background:#F6F4EF;border-left:4px solid #9C7744;border-radius:8px;">
  <tr><td style="padding:18px 20px;font-family:-apple-system,'Segoe UI',Arial,sans-serif;color:#15213A;font-size:15px;line-height:1.55;">
    <p style="margin:0 0 10px;font-size:17px;font-weight:bold;">Your order has been delivered{% if customer.first_name %}, {{ customer.first_name }}{% endif %}.</p>
    <p style="margin:0 0 10px;">Please check everything before you install it. If something is damaged or missing, send us your order number and a few photos.</p>
    <p style="margin:0 0 10px;">Happy with your order? A quick Google review helps other Perth renovators find us.</p>
<p style="margin:14px 0 0;"><a href="https://search.google.com/local/writereview?placeid=ChIJJ1zzJya-MioR2YywWzXHAJo" style="display:inline-block;background:#15213A;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-weight:bold;">Leave a Google review</a></p>
  </td></tr>
</table>
