{%- doc -%}
  WELS star rating and WaterMark badges under the price on plumbing product pages.
  Reads the `ets` metafields wels_rating ("5 Star"), flow_rate, wels_registration,
  watermark_licence_number and watermark_certifier. Renders nothing when the product has
  no compliance data, so it is safe on every product.
  @param {product} product
  @example
  {% render 'ets-pdp-compliance', product: product %}
{%- enddoc -%}
{%- liquid
  assign p = product | default: closest.product
  assign mf = p.metafields.ets
  assign stars = mf.wels_rating.value | default: '' | remove: 'WELS' | strip | split: ' ' | first | plus: 0
  assign has_wels = false
  if mf.wels_rating != blank or mf.wels_registration != blank
    assign has_wels = true
  endif
  assign has_wm = false
  if mf.watermark_licence_number != blank
    assign has_wm = true
  endif
-%}
{%- if has_wels or has_wm -%}
  <ul class="ets ets-cert" role="list">
    {%- if has_wels -%}
      <li class="ets-cert__item">
        {%- if stars > 0 -%}
          <span class="ets-cert__stars" role="img" aria-label="WELS {{ stars }} star water rating">
            {%- for i in (1..6) -%}<span class="ets-cert__star{% if i <= stars %} is-on{% endif %}" aria-hidden="true">&#9733;</span>{%- endfor -%}
          </span>
        {%- else -%}
          <span class="ets-cert__badge" aria-hidden="true">{% render 'ets-icon', name: 'drop' %}</span>
        {%- endif -%}
        <span class="ets-cert__text">
          <strong>{% if stars > 0 %}WELS {{ stars }} star{% else %}WELS {{ mf.wels_rating.value | escape }}{% endif %}</strong>
          {%- if mf.flow_rate != blank %} · {{ mf.flow_rate.value | escape }}{% endif -%}
          {%- if mf.wels_registration != blank %} · Reg. {{ mf.wels_registration.value | escape }}{% endif -%}
        </span>
      </li>
    {%- endif -%}
    {%- if has_wm -%}
      <li class="ets-cert__item">
        <span class="ets-cert__badge" aria-hidden="true">{% render 'ets-icon', name: 'shield' %}</span>
        <span class="ets-cert__text">
          <strong>WaterMark certified</strong> · Licence {{ mf.watermark_licence_number.value | escape }}
          {%- if mf.watermark_certifier != blank %} · {{ mf.watermark_certifier.value | escape }}{% endif -%}
        </span>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
{% stylesheet %}
  .ets-cert { display: grid; gap: 8px; margin: 0 0 4px; padding: 0; list-style: none; }
  .ets-cert__item { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 6px 12px; border-radius: var(--ets-r, 10px); box-shadow: inset 0 0 0 1px var(--ets-line, rgba(21, 33, 58, .12)); font-size: 13.5px; line-height: 1.4; color: var(--ets-ink, #15213A); }
  .ets-cert__text strong { font-weight: 700; }
  .ets-cert__stars { display: inline-flex; gap: 1px; flex: 0 0 auto; font-size: 17px; line-height: 1; letter-spacing: 0; }
  .ets-cert__star { color: var(--ets-line-strong, rgba(21, 33, 58, .22)); }
  .ets-cert__star.is-on { color: var(--ets-brass, #9C7744); }
  .ets-cert__badge { display: inline-flex; flex: 0 0 auto; width: 26px; height: 26px; align-items: center; justify-content: center; border-radius: 50%; background: var(--ets-brass-soft, #EFE6D6); color: var(--ets-brass, #9C7744); }
  .ets-cert__badge svg { width: 15px; height: 15px; }
{% endstylesheet %}
