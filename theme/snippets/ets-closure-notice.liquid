{%- doc -%}
  Christmas closure notice (Nov 2026). Rendered in the header top bar, the cart drawer and cart page (through
  ets-shipping-bar) and the product page perks. Shows from the day the theme is published; the wording changes on the
  closing day and the notice disappears by itself on the reopening day, so there is nothing to remove in January.
  Shipping pauses over the break; the Maddington showroom stays open by appointment.
  Next year: change the two dates and the day names below.
  @param {string} style - 'bar' (one short line for the top bar, which turns gold while active) or 'box' (cart and product page)
{%- enddoc -%}
{%- liquid
  assign closed_from = 20261218
  assign reopen = 20270106
  assign today = 'now' | date: '%Y%m%d' | plus: 0
-%}
{%- if today < reopen -%}
  {%- if style == 'bar' -%}
    {%- if today < closed_from -%}
      <span class="is-on">Christmas closure 18 Dec – 5 Jan · order any time, we ship from 6 Jan · showroom open by appointment</span>
    {%- else -%}
      <span class="is-on">Closed until Wed 6 Jan · order now, we ship from 6 Jan · showroom open by appointment</span>
    {%- endif -%}
    <style>
      .ets-topbar { background: #E9D6B5; color: #15213A; }
      .ets-topbar .ets-topbar__msg span { font-weight: 700; font-size: 13.5px; }
      .ets-topbar a, .ets-topbar .ets-topbar__trade { color: #15213A !important; }
    </style>
  {%- else -%}
    <div class="ets ets-closure" role="note">
      {% render 'ets-icon', name: 'calendar' %}
      <p>
        {%- if today < closed_from -%}
          <strong>Christmas closure: Friday 18 December to Tuesday 5 January.</strong>
          Shipping and deliveries pause over the break and restart when we reopen on Wednesday 6 January 2027. You can order any time: orders placed from 18 December are packed and shipped from 6 January. The Maddington showroom stays open by appointment, so you can still come in and see the range.
        {%- else -%}
          <strong>Closed for Christmas until Wednesday 6 January 2027.</strong>
          You can still order: we pack and ship from 6 January. The Maddington showroom stays open by appointment.
        {%- endif -%}
      </p>
    </div>
    <style>
      .ets-closure { display: flex; gap: 12px; align-items: flex-start; margin: 0 0 16px; padding: 16px 18px; border-radius: 14px; border-left: 5px solid #9C7744; background: #FBF3E4; box-shadow: inset 0 0 0 1px rgba(156, 119, 68, .45); color: #15213A; font-size: 14.5px; line-height: 1.5; }
      .ets-closure svg { flex-shrink: 0; width: 24px; height: 24px; color: #9C7744; margin-top: 1px; }
      .ets-closure p { margin: 0; }
      .ets-closure strong { display: block; margin-bottom: 3px; font-size: 16px; }
    </style>
  {%- endif -%}
{%- endif -%}
