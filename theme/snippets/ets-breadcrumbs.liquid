{% doc %}
  Renders a visible breadcrumb trail and matching BreadcrumbList structured data.
  Home is always first; the current page is the last item and is not linked.

  @param {collection} [parent] - Optional parent collection shown between Home and the current page
  @param {string} current_title - Title of the current page
  @param {string} current_url - Relative URL of the current page

  @example
  {% render 'ets-breadcrumbs', parent: collection, current_title: product.title, current_url: product.url %}
{% enddoc %}

<nav class="ets-crumbs" aria-label="Breadcrumb">
  <ol role="list">
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {%- if parent != blank -%}
      <li><a href="{{ parent.url }}">{{ parent.title | escape }}</a></li>
    {%- endif -%}
    <li><span aria-current="page">{{ current_title | escape }}</span></li>
  </ol>
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | append: routes.root_url | json }}
      },
      {%- if parent != blank -%}
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ parent.title | json }},
          "item": {{ request.origin | append: parent.url | json }}
        },
      {%- endif -%}
      {
        "@type": "ListItem",
        "position": {% if parent != blank %}3{% else %}2{% endif %},
        "name": {{ current_title | json }},
        "item": {{ request.origin | append: current_url | json }}
      }
    ]
  }
</script>
