{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content="#F4F8FB"
>

{%- liquid
  if request.page_type == 'index'
    assign page_title = 'Tiles, Vanities & Tapware Online Australia | ETS'
    assign page_description = 'Shop tiles, bathroom vanities, tapware, sinks, mirrors and bathroomware online at ETS. Order online or book a visit to our Maddington showroom.'
  elsif request.page_type == 'page' and page.handle == 'trade-account'
    assign page_title = 'Trade Account | Bathroom & Tile Trade Supply | ETS'
    assign page_description = 'Apply for an ETS trade account for bathroom, tile, tapware and related product supply. Ideal for builders, plumbers, tilers and renovators.'
  elsif request.page_type == 'page' and page.handle == 'book-appointment'
    assign page_title = 'Book ETS Maddington Showroom | Bathroom & Tile Products'
    assign page_description = 'Book a visit to the ETS Maddington showroom to compare tiles, vanities, tapware, mirrors and bathroom products in person by appointment.'
  elsif request.page_type == 'page' and page.handle == 'delivery-pickup'
    assign page_title = 'Delivery & International Freight | ETS'
    assign page_description = 'ETS delivers across Australia plus NZ, US, UK and UAE. Standard parcels price at checkout; bulky tiles and bathroomware use a freight quote.'
  endif
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- comment -%} Custom SEO titles already carry a " | " keyword or brand part; don't push them past 60 chars. {%- endcomment -%}
  {%- unless page_title contains shop.name or page_title contains ' | ' %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- comment -%} ETS internal trade collections are operational pricing lists, not search landing pages. {%- endcomment -%}
{%- if request.page_type == 'collection' and collection.handle contains 'trade-' -%}
  <meta name="robots" content="noindex,follow">
{%- endif -%}

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HardwareStore", "HomeAndConstructionBusiness", "OnlineStore"],
  "@id": {{ shop.url | append: '#business' | json }},
  "name": "Excellent Tiling Services Pty Ltd",
  "url": {{ shop.url | json }},
  "logo": "https://cdn.shopify.com/s/files/1/0683/0292/9983/files/ets-logo-icon.png?v=1790150823",
  "image": "https://cdn.shopify.com/s/files/1/0683/0292/9983/files/ets-logo-icon.png?v=1790150823",
  "hasMap": "https://www.google.com/maps/search/?api=1&query=17A+Olga+Road+Maddington+WA+6109",
  "telephone": "+61 450 960 543",
  "email": "contactus@excellenttilingservice.com.au",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "17A Olga Road",
    "addressLocality": "Maddington",
    "addressRegion": "WA",
    "postalCode": "6109",
    "addressCountry": "AU"
  },
  "description": "Excellent Tiling Services (ETS) is a tile and bathroom retailer in Maddington, Perth. We sell tiles, tile adhesive, grout, silicone, tiling tools and trims, vanities, tapware, toilets, mirrors and bathroomware to the public and to trade customers (tilers, builders, plumbers, renovators) through our online store and by-appointment showroom. Online orders ship across Australia and to selected international markets; pickup in Maddington is free. Trade accounts receive a discount at checkout. We also quote on tiling work in the Perth metro area.",
  "slogan": "Tiles, bathroomware and tiling supplies. Retail and trade. Perth and Australia-wide.",
  "audience": [
    { "@type": "PeopleAudience", "audienceType": "Homeowners and renovators" },
    { "@type": "BusinessAudience", "audienceType": "Trade: tilers, builders, plumbers, renovators and property managers" }
  ],
  "brand": [
    { "@type": "Brand", "name": "Sika" }, { "@type": "Brand", "name": "Raimondi" }, { "@type": "Brand", "name": "BAT" },
    { "@type": "Brand", "name": "Sigma" }, { "@type": "Brand", "name": "Maxisil" }, { "@type": "Brand", "name": "Panther" },
    { "@type": "Brand", "name": "Washboy" }, { "@type": "Brand", "name": "Baron" }, { "@type": "Brand", "name": "RLA" }, { "@type": "Brand", "name": "MELA" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "What ETS sells",
    "url": {{ shop.url | append: routes.collections_url | json }},
    "itemListElement": [
      { "@type": "OfferCatalog", "name": "Tiles: porcelain floor and wall tiles, sold per m²", "url": {{ shop.url | append: '/collections/tiles' | json }} },
      { "@type": "OfferCatalog", "name": "Tile adhesive, grout and silicone", "url": {{ shop.url | append: '/collections/tile-adhesive' | json }} },
      { "@type": "OfferCatalog", "name": "Tiling tools, machines, trims and hardware", "url": {{ shop.url | append: '/collections/hardware' | json }} },
      { "@type": "OfferCatalog", "name": "Bathroom vanities and storage", "url": {{ shop.url | append: '/collections/vanities-basins' | json }} },
      { "@type": "OfferCatalog", "name": "Tapware, showers and sinks", "url": {{ shop.url | append: '/collections/tapware-sinks' | json }} },
      { "@type": "OfferCatalog", "name": "Baths and toilets", "url": {{ shop.url | append: '/collections/baths-toilets' | json }} },
      { "@type": "OfferCatalog", "name": "Mirrors and bathroom accessories", "url": {{ shop.url | append: '/collections/mirrors-accessories' | json }} },
      { "@type": "OfferCatalog", "name": "Tiling services in Perth (quotes)", "url": {{ shop.url | append: '/pages/tiling-services' | json }} }
    ]
  },
  "areaServed": [
    { "@type": "Country", "name": "Australia" },
    { "@type": "Country", "name": "New Zealand" },
    { "@type": "Country", "name": "United States" },
    { "@type": "Country", "name": "United Kingdom" },
    { "@type": "Country", "name": "United Arab Emirates" }
  ],
  "priceRange": "$$",
  "currenciesAccepted": "AUD, NZD, USD, GBP, AED",
  "knowsAbout": ["Tiling", "Tile adhesive", "Grout", "Waterproofing and wet area tiling", "Porcelain tiles", "Floor tiles", "Wall tiles", "Tiling tools", "Tile trims", "Bathroom renovation", "Bathroomware", "Vanities", "Tapware", "Toilets", "Mirrors", "Heated towel rails", "Shower screens", "Trade supply for tilers and builders"],
  {%- if shop.refund_policy %}
  "hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "applicableCountry": "AU",
    "returnPolicyCountry": "AU",
    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
    "merchantReturnDays": 30,
    "returnFees": "https://schema.org/RestockingFees",
    "restockingFee": 15,
    "merchantReturnLink": {{ shop.url | append: shop.refund_policy.url | json }}
  },
  {%- endif %}
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "16:30",
    "closes": "21:00"
  }],
  "potentialAction": [
    { "@type": "BuyAction", "name": "Shop online", "target": {{ shop.url | append: routes.collections_url | json }} },
    { "@type": "SearchAction", "name": "Search the store", "target": { "@type": "EntryPoint", "urlTemplate": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}" }, "query-input": "required name=search_term_string" }
    {%- if pages['book-appointment'] != blank %},
    { "@type": "ReserveAction", "name": "Book a showroom visit", "target": {{ shop.url | append: pages['book-appointment'].url | json }} }
    {%- endif %}
    {%- if pages['trade-account'] != blank %},
    { "@type": "RegisterAction", "name": "Apply for a trade account", "target": {{ shop.url | append: pages['trade-account'].url | json }} }
    {%- endif %}
  ],
  "sameAs": [
    "https://www.instagram.com/excellent_tiling_services/",
    "https://www.facebook.com/share/1943ueL61k/?mibextid=wwXIfr"
  ]
}
</script>

{%- render 'ets-structured-data' -%}
