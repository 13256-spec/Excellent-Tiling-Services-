{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content="#F4F8FB"
>

{%- liquid
  if request.page_type == 'index' and page_title == shop.name
    assign page_title = 'Tiles & Tiling Perth | Bathroomware Showroom | ETS'
  endif
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- comment -%} Custom SEO titles already end in "| ETS Perth" or similar; don't push them past 60 chars. {%- endcomment -%}
  {%- unless page_title contains shop.name or page_title contains '| ETS' or page_title contains 'Perth' %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
  "@id": {{ shop.url | append: '#business' | json }},
  "name": "Excellent Tiling Services Pty Ltd",
  "url": {{ shop.url | json }},
  "logo": "https://cdn.shopify.com/s/files/1/0683/0292/9983/files/ets-logo-icon.png?v=1790150823",
  "image": "https://cdn.shopify.com/s/files/1/0683/0292/9983/files/ets-logo-icon.png?v=1790150823",
  "hasMap": "https://www.google.com/maps/search/?api=1&query=17A+Olga+Road+Maddington+WA+6109",
  "telephone": "+61 450 960 543",
  "email": "contactus@excellenttilingservice.com.au",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "17A Olga Road",
    "addressLocality": "Maddington",
    "addressRegion": "WA",
    "postalCode": "6109",
    "addressCountry": "AU"
  },
  "description": "Perth tiling contractor and bathroomware showroom in Maddington WA. Showroom visits by appointment, Monday to Saturday 4:30 pm to 9 pm.",
  "areaServed": "Perth, Western Australia",
  "priceRange": "$$",
  "currenciesAccepted": "AUD",
  "knowsAbout": ["Tiling", "Porcelain tiles", "Floor tiles", "Wall tiles", "Bathroom renovation", "Bathroomware", "Vanities", "Tapware", "Toilets", "Mirrors", "Heated towel rails", "Shower screens"],
  {%- if shop.refund_policy %}
  "hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "applicableCountry": "AU",
    "returnPolicyCountry": "AU",
    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
    "merchantReturnDays": 30,
    "returnFees": "https://schema.org/RestockingFees",
    "restockingFee": 15,
    "merchantReturnLink": {{ shop.url | append: shop.refund_policy.url | json }}
  },
  {%- endif %}
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "16:30",
    "closes": "21:00"
  }],
  {%- if pages['book-appointment'] != blank %}
  "potentialAction": {
    "@type": "ReserveAction",
    "name": "Book a showroom visit",
    "target": {{ shop.url | append: pages['book-appointment'].url | json }}
  },
  {%- endif %}
  "sameAs": [
    "https://www.instagram.com/excellent_tiling_services/",
    "https://www.facebook.com/share/1943ueL61k/?mibextid=wwXIfr"
  ]
}
</script>
