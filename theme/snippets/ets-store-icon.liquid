{% when 'person' %}<circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>
{% when 'menu' %}<path d="M3 6h18M3 12h18M3 18h18"/>
{% when 'arrow' %}<path d="M4 12h16m-6-6 6 6-6 6"/>
{% when 'pin' %}<path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z"/><circle cx="12" cy="10" r="2"/>
{% when 'tiles' %}<path d="M3 3h8v8H3zM14 3h7v8h-7zM3 14h8v7H3zM14 14h7v7h-7z"/>
{% when 'hardware' %}<path d="m14 6 4-4a6 6 0 0 1-7 8L4 21l-3-3 11-7a6 6 0 0 1 8-7l-4 4Z"/>
