{% doc %}
  Renders a decorative navigation icon.
  @param {string} name - Icon name
{% enddoc %}
<svg class="ets-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% case name %}
{% when 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
