{%- doc -%}
  Slow, looping strip of a collection's live products. Pauses on hover and keyboard focus;
  with reduced motion it becomes a swipeable row instead.
  @param {collection} collection
  @param {number} [limit] - most products to show (default 24)
  @param {string} [size] - 'md' (page heroes) or 'sm' (menu panels)
  @param {boolean} [defer] - hold image loading until the menu panel opens
  @param {boolean} [static] - one still row of up to `limit` products: no scrolling, no repeated copies (menu panels)
{%- enddoc -%}
{%- liquid
  assign limit = limit | default: 24
  assign size = size | default: 'md'
  assign count = collection.products.size
  if count > limit
    assign count = limit
  endif
  assign seconds_per_item = 4.5
  if size == 'sm'
    assign seconds_per_item = 4
  endif
-%}
{%- if collection != blank and count >= 3 -%}
  {%- liquid
    comment
      Repeat short lists so one pass is wider than the screen; the second, hidden copy makes the loop seamless.
    endcomment
    assign reps = 12 | divided_by: count
    assign passes = 2
    if static
      assign reps = 1
      assign passes = 1
    endif
    if reps < 1
      assign reps = 1
    endif
    assign per_pass = count | times: reps
    assign duration = per_pass | times: seconds_per_item
    assign img_width = 400
    if size == 'sm'
      assign img_width = 240
    endif
  -%}
  <div class="ets-pmq ets-pmq--{{ size }}{% if static %} ets-pmq--static{% endif %}"{% unless static %} style="--pmq-dur: {{ duration }}s"{% endunless %} role="region" aria-label="{{ collection.title | escape }} products">
    <div class="ets-pmq__track">
      {%- for pass in (1..passes) -%}
        <ul class="ets-pmq__list" role="list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
          {%- for r in (1..reps) -%}
            {%- for product in collection.products limit: limit -%}
              {%- assign img = product.featured_media.preview_image -%}
              <li class="ets-pmq__item{% if r > 1 %} is-repeat{% endif %}">
                <a href="{{ product.url }}"{% if pass == 2 or r > 1 %} tabindex="-1"{% endif %}>
                  <span class="ets-pmq__media{% if product.type == 'Tile' %} is-cover{% endif %}">
                    {%- if img != blank -%}
                      {%- if defer -%}
                        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" data-pmq-src="{{ img | image_url: width: img_width }}" width="{{ img_width }}" height="{{ img_width }}" alt="{% if pass == 1 and r == 1 %}{{ product.title | escape }}{% endif %}">
                      {%- else -%}
                        {{ img | image_url: width: img_width | image_tag: loading: 'lazy', widths: '240, 400', sizes: '200px', alt: product.title }}
                      {%- endif -%}
                    {%- endif -%}
                  </span>
                  <span class="ets-pmq__title">{{ product.title | escape }}</span>
                  <span class="ets-pmq__price">{% render 'price', product_resource: product %}</span>
                </a>
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .ets-pmq { position: relative; overflow: hidden; margin-top: clamp(28px, 4vw, 44px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .ets-pmq__track { display: flex; width: max-content; animation: ets-pmq-scroll var(--pmq-dur, 60s) linear infinite; }
  .ets-pmq:hover .ets-pmq__track, .ets-pmq:focus-within .ets-pmq__track { animation-play-state: paused; }
  .ets-pmq__list { display: flex; gap: 16px; margin: 0; padding: 0 16px 0 0; list-style: none; }
  .ets-pmq__item { flex: 0 0 auto; width: 188px; }
  .ets-pmq--sm .ets-pmq__item { width: 132px; }
  .ets-pmq__item a { display: grid; gap: 8px; color: var(--ets-ink); text-decoration: none; }
  .ets-pmq__media { position: relative; display: block; aspect-ratio: 1; border-radius: var(--ets-r-sm, 12px); background: #fff; box-shadow: inset 0 0 0 1px var(--ets-line); overflow: hidden; }
  .ets-pmq__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 10%; transition: transform .8s var(--ets-ease); }
  .ets-pmq__media.is-cover img { object-fit: cover; padding: 0; }
  .ets-pmq__item a:hover .ets-pmq__media img { transform: scale(1.05); }
  .ets-pmq__title { font-size: 13.5px; font-weight: 600; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ets-pmq--sm .ets-pmq__title { font-size: 12.5px; }
  .ets-pmq__price { font-size: 13px; font-weight: 700; color: var(--ets-ink-soft, var(--ets-ink)); }
  .ets-pmq__item a:focus-visible { outline: 2px solid var(--ets-brass); outline-offset: 4px; border-radius: var(--ets-r-sm, 12px); }
  .ets-mega__strip { grid-column: 1 / -1; padding: 22px 40px 28px; border-top: 1px solid var(--ets-line); }
  .ets-mega__strip .ets-pmq { margin-top: 14px; }
  .ets-mega__strip-label { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--ets-muted); }
  .ets-pmq--static { -webkit-mask-image: none; mask-image: none; }
  .ets-pmq--static .ets-pmq__track { width: auto; animation: none; }
  .ets-pmq--static .ets-pmq__list { flex-wrap: wrap; padding-right: 0; }
  @keyframes ets-pmq-scroll { to { transform: translateX(-50%); } }
  @media (max-width: 749px) { .ets-pmq__item { width: 148px; } }
  @media (prefers-reduced-motion: reduce) {
    .ets-pmq { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .ets-pmq__track { animation: none; }
    .ets-pmq__list[aria-hidden="true"], .ets-pmq__item.is-repeat { display: none; }
  }
{% endstylesheet %}
