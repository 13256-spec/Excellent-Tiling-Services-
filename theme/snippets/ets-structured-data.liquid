{%- liquid
  assign ets_business_url = 'https://excellenttilingservice.com.au'
  assign ets_logo_url = 'https://cdn.shopify.com/s/files/1/0683/0292/9983/files/ets-logo-icon.png?v=1790150823'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": "{{ ets_business_url }}/#business",
  "name": {{ shop.name | json }},
  "url": {{ ets_business_url | json }},
  "logo": {{ ets_logo_url | json }},
  "image": {{ ets_logo_url | json }},
  "telephone": "+61450960543",
  "email": {{ shop.email | json }},
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "17A Olga Road",
    "addressLocality": "Maddington",
    "addressRegion": "WA",
    "postalCode": "6109",
    "addressCountry": "AU"
  },
  "areaServed": {
    "@type": "City",
    "name": "Perth, Western Australia"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "16:30",
      "closes": "21:00"
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ ets_business_url }}/#website",
  "url": {{ ets_business_url | json }},
  "name": {{ shop.name | json }},
  "publisher": { "@id": "{{ ets_business_url }}/#business" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ ets_business_url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- if request.page_type == 'product' and product -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ ets_business_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- elsif request.page_type == 'product' and product -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ ets_business_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- endif -%}
