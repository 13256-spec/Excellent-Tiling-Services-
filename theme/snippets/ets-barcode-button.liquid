{%- doc -%}
  "View barcode" button for the product codes table (the dialog lives in ets-product-specs).
  @param {string} [code] - the variant's barcode number, used when set
  @param {string} sku - the product code, used when there is no barcode number
  @param {string} label - what the code is for (variant or product title)
{%- enddoc -%}
{%- assign value = code | default: sku | strip -%}
{%- if value != blank -%}
  <button type="button" class="ets-bc-btn" data-ets-barcode-open data-code="{{ value | escape }}" data-label="{{ label | escape }}" aria-haspopup="dialog">
    <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M1 3h1.5v10H1zM3.5 3h.8v10h-.8zM5.5 3H7v10H5.5zM8 3h.8v10H8zM10 3h1.5v10H10zM12.5 3h.8v10h-.8zM14.3 3h.7v10h-.7z"/></svg>
    <span>View barcode<span class="ets-visually-hidden"> for {{ label | escape }}</span></span>
  </button>
{%- endif -%}
