{%- doc -%}
  Tile quantity calculator for tile products. Sets the product form quantity (m², or boxes for box-units tiles).
  @param {product} product
{%- enddoc -%}
{%- liquid
  assign is_tile = false
  assign tile_types = settings.ets_trade_tile_types | default: 'Tile' | split: ','
  for t in tile_types
    assign tt = t | strip
    if tt == product.type
      assign is_tile = true
    endif
  endfor
  # Mosaics are sold per sheet; the m² calculator does not apply (16 Nov 2026).
  if product.tags contains 'Mosaic'
    assign is_tile = false
  endif
  # ETS: box-units (one variant = one box) wins over m2-units. m² per box comes from the selected variant's
  # unit price measurement; Horizon re-renders this block on variant change, so data-box follows the size.
  assign ets_box = false
  assign ets_box_m2 = product.selected_or_first_available_variant.unit_price_measurement.quantity_value
  if product.tags contains 'box-units' and ets_box_m2
    assign ets_box = true
  elsif product.tags contains 'box-units'
    # ETS: box-units product with no box size on the variant: no calculator rather than one that sets m² as a box count.
    assign is_tile = false
  endif
-%}
{%- if is_tile -%}
  <div class="ets ets-calc" data-ets-calc{% if ets_box %} data-box="{{ ets_box_m2 }}"{% elsif product.tags contains 'm2-units' %} data-m2{% endif %}>
    <p class="ets-calc__head" style="margin:0 0 12px">{% render 'ets-icon', name: 'ruler' %}How much do I need?</p>
    <div class="ets-calc__row">
      <label>Area (m²)<input type="number" inputmode="decimal" min="0" step="0.01" placeholder="e.g. 12.5" data-area></label>
      <label>or length (m)<input type="number" inputmode="decimal" min="0" step="0.01" placeholder="4.2" data-len></label>
      <label>× width (m)<input type="number" inputmode="decimal" min="0" step="0.01" placeholder="3.0" data-wid></label>
    </div>
    <div class="ets-calc__row" style="grid-template-columns:1fr;margin-top:10px">
      {%- if ets_box -%}
        {%- comment -%} ETS: box-units only. Every other tile keeps the 0/10/15/20% select below. {%- endcomment -%}
        <label class="ets-calc__waste"><input type="checkbox" data-waste value="15" checked> Add 15% wastage</label>
      {%- else -%}
      <label>Allowance for cuts
        <select data-waste>
          <option value="0">No extra — exact area</option>
          <option value="10" selected>10% — straight lay, simple room</option>
          <option value="15">15% — brick bond or lots of cuts</option>
          <option value="20">20% — herringbone or diagonal</option>
        </select>
      </label>
      {%- endif -%}
    </div>
    <div class="ets-calc__out" aria-live="polite">
      <span>Order <strong data-out>—</strong></span>
      <button class="ets-calc__apply" type="button" data-apply disabled>Set quantity</button>
    </div>
    {%- if ets_box -%}
      <p class="ets-calc__note">Tiles are sold by the box. We round up to the nearest full box ({{ ets_box_m2 }} m² per box). Keep a few spare for future repairs.</p>
    {%- elsif product.tags contains 'm2-units' -%}
      <p class="ets-calc__note">Tiles are sold per m², in steps of 0.01 m². Keep a few spare for future repairs.</p>
    {%- else -%}
      <p class="ets-calc__note">Tiles are priced and sold per m². Rounded up to the next whole m². Keep a few spare for future repairs.</p>
    {%- endif -%}
  </div>
{%- endif -%}
