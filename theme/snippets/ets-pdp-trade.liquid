{%- doc -%}
  Trade account prompt / confirmation under the product price.
  @param {product} [product]
{%- enddoc -%}
{%- liquid
  assign trade_tag = settings.ets_trade_tag | default: 'trade'
  assign is_trade = false
  if customer and customer.tags contains trade_tag
    assign is_trade = true
  endif
  assign p = product | default: closest.product
  capture pct
    render 'ets-trade-rate', product: p
  endcapture
  assign pct = pct | strip | plus: 0
-%}
{%- if settings.ets_trade_enabled -%}
  {%- if is_trade -%}
    <p class="ets ets-trade-note ets-trade-note--on" style="margin:0">
      {%- if pct > 0 -%}
        <span>✓ Trade price shown: {{ pct }}% off the retail price. The discount comes off in the cart.</span>
      {%- else -%}
        <span>Trade account: this item is at the retail price (no trade discount on this one).</span>
      {%- endif -%}
    </p>
  {%- else -%}
    <p class="ets ets-trade-note" style="margin:0">
      <span>Builder or tradie? Trade accounts get 5–25% off, depending on the item.</span>
      <span>
        <a href="{{ settings.ets_trade_page.url | default: '/pages/trade-account' }}">Apply</a>
        {%- if customer == nil %} · <a href="{{ routes.account_login_url }}">Log in</a>{% endif -%}
      </span>
    </p>
  {%- endif -%}
{%- endif -%}
