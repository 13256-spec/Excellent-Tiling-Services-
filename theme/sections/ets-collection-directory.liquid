<section class="ets-retail-section"><div class="ets-container"><div class="ets-page-heading"><p class="ets-overline">Shop Excellent Tiling Services</p><h1>Every part of your project.</h1><p>Bathroom accessories, hardware and tiles. Start with a department, then explore the details.</p></div><nav class="ets-directory-departments" aria-label="Main departments"><a href="{{ collections['accessories'].url }}"><span>01</span><h2>Bathroom accessories</h2><p>Towel rails, hooks, holders and the essentials that complete the room.</p>{% render 'ets-store-icon', name: 'arrow' %}</a><a href="{{ collections['hardware'].url }}"><span>02</span><h2>Hardware</h2><p>Discuss trims, fixings and renovation hardware for the job.</p>{% render 'ets-store-icon', name: 'arrow' %}</a><a href="{{ collections['tiles'].url }}"><span>03</span><h2>Tiles</h2><p>Explore floor and wall tile requirements with our team.</p>{% render 'ets-store-icon', name: 'arrow' %}</a></nav><div class="ets-section-head"><h2>Explore the bathroom</h2></div><div class="ets-category-tiles">{% assign handles = 'accessories,towel-rails,bathroom-hooks,tapware,bathroom-vanities,basins,baths,mirrors,shower-screens,toilets,soap-shelf-holders,toilet-roll-holders' | split: ',' %}{% for handle in handles %}{% assign item = collections[handle] %}{% if item != blank %}<a class="ets-category-tile" href="{{ item.url }}">{% if item.image %}<span class="ets-category-tile-image">{{ item.image | image_url: width: 600 | image_tag: widths: '240, 400, 600', sizes: '(min-width: 990px) 16vw, 45vw', loading: 'lazy', alt: '' }}</span>{% endif %}<span class="ets-category-tile-title">{{ item.title | escape }} {% render 'ets-store-icon', name: 'arrow' %}</span></a>{% endif %}{% endfor %}</div></div></section>
