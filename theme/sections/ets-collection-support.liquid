<section class="ets-retail-section"><div class="ets-container">{% if collection.products_count == 0 %}<div class="ets-empty-department"><div><p class="ets-overline">Product enquiries</p><h2>Let's find what your project needs.</h2><p>Contact ETS to discuss {{ collection.title | downcase | escape }}, available options and pricing. Bring your measurements, preferred finish or a reference photo to help us understand what you need.</p></div><div class="ets-enquiry-checklist"><h3>Useful details to have ready</h3><ul><li>The room or application</li><li>Sizes, measurements or quantities</li><li>Your preferred look or finish</li><li>Delivery suburb and project timing</li></ul><a class="ets-link" href="{{ pages['contact'].url }}">Visit or contact the showroom {% render 'ets-store-icon', name: 'arrow' %}</a></div></div>{% else %}<div class="ets-service-strip"><div><h2>Need help choosing?</h2><p>Talk through sizes, finishes and product requirements with our Maddington team.</p></div><a class="ets-btn ets-btn-outline" href="{{ pages['contact'].url }}">Ask our team {% render 'ets-store-icon', name: 'arrow' %}</a></div>{% endif %}<div class="ets-department-crosslinks"><a href="{{ collections['accessories'].url }}">Bathroom accessories {% render 'ets-store-icon', name: 'arrow' %}</a><a href="{{ collections['hardware'].url }}">Hardware {% render 'ets-store-icon', name: 'arrow' %}</a><a href="{{ collections['tiles'].url }}">Tiles {% render 'ets-store-icon', name: 'arrow' %}</a></div></div></section>
