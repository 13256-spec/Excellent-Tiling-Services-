{%- comment -%}
  Recently viewed: remembers the products a visitor opens (in their own browser only, nothing is
  sent anywhere) and shows them again as a row above the footer. Hidden until there is something
  to show. On a product page it records that product and leaves it out of the row.
{%- endcomment -%}
<section
  class="ets ets-sec ets-rv"
  data-ets-rv
  data-current="{{ product.handle | default: '' }}"
  data-max="{{ section.settings.max }}"
  data-shop-currency="{{ shop.currency }}"
  aria-labelledby="EtsRv-{{ section.id }}"
  hidden
>
  <div class="ets-wrap">
    <div class="ets-rv__head">
      <h2 class="ets-rv__title" id="EtsRv-{{ section.id }}">
        {%- if template.name == 'index' -%}
          {{- section.settings.heading_home | escape -}}
        {%- else -%}
          {{- section.settings.heading | escape -}}
        {%- endif -%}
      </h2>
      <button type="button" class="ets-rv__clear" data-ets-rv-clear>{{ section.settings.clear_label | escape }}</button>
    </div>
    <ul class="ets-rv__list" role="list" data-ets-rv-list></ul>
  </div>
</section>

<script>
  (function () {
    var KEY = 'ets-recently-viewed';
    var KEEP = 12;
    var read = function () { try { return JSON.parse(localStorage.getItem(KEY)) || []; } catch (e) { return []; } };
    var write = function (list) { try { localStorage.setItem(KEY, JSON.stringify(list)); } catch (e) { /* storage blocked */ } };
    var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
    var currency = (window.Shopify && Shopify.currency && Shopify.currency.active) || '';
    // products/<handle>.js prices are already in the visitor's currency (Shopify Markets).
    var money = function (cents, code) {
      try { return new Intl.NumberFormat('en-AU', { style: 'currency', currency: code, currencyDisplay: 'narrowSymbol' }).format(cents / 100); }
      catch (e) { return '$' + (cents / 100).toFixed(2); }
    };
    var sized = function (src, width) {
      if (!src) return '';
      var url = new URL(src, location.href);
      url.searchParams.set('width', width);
      return url.toString();
    };

    document.querySelectorAll('[data-ets-rv]:not([data-ready])').forEach(function (el) {
      el.dataset.ready = '1';
      var current = el.dataset.current;
      var max = parseInt(el.dataset.max, 10) || 6;
      var code = currency || el.dataset.shopCurrency || 'AUD';
      var seen = read();
      var show = seen.filter(function (h) { return h !== current; }).slice(0, max);
      if (current) write([current].concat(seen.filter(function (h) { return h !== current; })).slice(0, KEEP));

      el.querySelector('[data-ets-rv-clear]').addEventListener('click', function () {
        write(current ? [current] : []);
        el.hidden = true;
      });
      if (!show.length) return;

      Promise.all(show.map(function (handle) {
        return fetch(root + 'products/' + encodeURIComponent(handle) + '.js')
          .then(function (r) { return r.ok ? r.json() : null; })
          .catch(function () { return null; });
      })).then(function (products) {
        // Forget products that were deleted or unpublished.
        var gone = show.filter(function (h, i) { return !products[i]; });
        if (gone.length) write(read().filter(function (h) { return gone.indexOf(h) === -1; }));

        var list = el.querySelector('[data-ets-rv-list]');
        products.forEach(function (p) {
          if (!p) return;
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.className = 'ets-rv__card';
          a.href = p.url;
          var media = document.createElement('span');
          media.className = 'ets-rv__media';
          if (p.featured_image) {
            var img = document.createElement('img');
            img.src = sized(p.featured_image, 400);
            img.alt = '';
            img.loading = 'lazy';
            img.width = 400;
            img.height = 400;
            media.appendChild(img);
          }
          var name = document.createElement('span');
          name.className = 'ets-rv__name';
          name.textContent = p.title;
          var price = document.createElement('span');
          price.className = 'ets-rv__price';
          price.textContent = (p.price_varies ? 'From ' : '') + money(p.price, code);
          a.append(media, name, price);
          li.appendChild(a);
          list.appendChild(li);
        });
        if (list.children.length) el.hidden = false;
      });
    });
  })();
</script>

{% stylesheet %}
  .ets-rv { border-top: 1px solid var(--ets-line); }
  .ets-rv[hidden] { display: none; }
  .ets-rv__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .ets-rv__title { margin: 0; font: 700 clamp(22px, 2vw, 28px)/1.15 var(--ets-sans); letter-spacing: -.01em; color: var(--ets-ink); }
  .ets-rv__clear { border: 0; background: none; padding: 4px 0; font: 600 13px var(--ets-sans); color: var(--ets-muted); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .ets-rv__clear:hover { color: var(--ets-ink); }
  .ets-rv__list { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 1fr); gap: 16px; margin: 0; padding: 0 0 6px; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .ets-rv__list > li { scroll-snap-align: start; min-width: 0; }
  @media (min-width: 990px) { .ets-rv__list { grid-auto-columns: calc((100% - 5 * 16px) / 6); } }
  @media (max-width: 749px) { .ets-rv__list { grid-auto-columns: 42%; gap: 12px; } }
  .ets-rv__card { display: flex; flex-direction: column; gap: 8px; color: var(--ets-ink); text-decoration: none; }
  .ets-rv__media { display: block; aspect-ratio: 1; background: var(--ets-surface); border: 1px solid var(--ets-line); border-radius: 12px; overflow: hidden; transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
  .ets-rv__media img { width: 100%; height: 100%; object-fit: contain; padding: 9%; mix-blend-mode: multiply; }
  .ets-rv__card:hover .ets-rv__media { border-color: var(--ets-line-strong); box-shadow: 0 10px 24px -14px rgba(15, 26, 44, .35); transform: translateY(-2px); }
  .ets-rv__name { font-size: 14px; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ets-rv__price { font-size: 14px; font-weight: 700; }
{% endstylesheet %}

{% schema %}
{
  "name": "ETS recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "text", "id": "heading_home", "label": "Heading on the home page", "default": "Pick up where you left off" },
    { "type": "text", "id": "clear_label", "label": "Clear link", "default": "Clear" },
    { "type": "range", "id": "max", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "ETS recently viewed" }]
}
{% endschema %}
