<section class="ets-retail-section"><div class="ets-container"><div class="ets-page-heading"><p class="ets-overline">ETS Journal</p><h1>{{ blog.title | escape }}</h1><p>Ideas, materials and project notes for bathrooms, tiles and considered renovations.</p></div>{% paginate blog.articles by 12 %}<div class="ets-journal-grid">{% for article in blog.articles %}<article>{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 990px) 30vw, 100vw', loading: 'lazy', alt: article.title }}</a>{% endif %}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %B %Y' }}</time><h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p><a class="ets-link" href="{{ article.url }}">Read article {% render 'ets-store-icon', name: 'arrow' %}</a></article>{% else %}<div class="ets-page-heading"><h2>Planning a bathroom or tiling project?</h2><p>Speak to our team about materials, product selections and your plans.</p><a class="ets-btn" href="{{ pages['contact'].url }}">Contact ETS</a></div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav aria-label="Blog pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</div></section>
{% schema %}{"name":"ETS blog page","settings":[],"presets":[{"name":"ETS blog page"}]}{% endschema %}
