{%- liquid
  assign mf = product.metafields.ets
  assign has_dimensions = false
  if mf.width_mm != blank or mf.height_mm != blank or mf.depth_mm != blank or mf.diameter_mm != blank
    assign has_dimensions = true
  endif
  assign has_care = false
  if mf.warranty != blank or mf.care != blank
    assign has_care = true
  endif
  assign has_downloads = false
  if mf.spec_sheet != blank or mf.technical_drawing != blank
    assign has_downloads = true
  endif
  assign sku_count = 0
  assign first_sku = ''
  for variant in product.variants
    if variant.sku != blank
      assign sku_count = sku_count | plus: 1
      if first_sku == blank
        assign first_sku = variant.sku
      endif
    endif
  endfor
-%}

<section class="ets ets-specs" aria-labelledby="EtsSpecs-{{ section.id }}">
  <div class="ets-wrap ets-specs__grid">
    <div class="ets-specs__intro">
      <h2 id="EtsSpecs-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.show_help -%}
        <p>
          Need help choosing or confirming fit?
          <a href="{{ section.settings.help_url | default: '/pages/contact' }}">Talk to our Maddington showroom</a>
          or call <a href="tel:+61450960543">0450&nbsp;960&nbsp;543</a>.
        </p>
      {%- endif -%}
    </div>

    <div class="ets-specs__panels">
      <details class="ets-specs__item" open>
        <summary>Specifications</summary>
        <dl class="ets-specs__list">
          {%- if product.vendor != blank -%}<div><dt>Brand</dt><dd>{{ product.vendor | escape }}</dd></div>{%- endif -%}
          {%- if mf.range != blank -%}<div><dt>Range</dt><dd>{{ mf.range.value | escape }}</dd></div>{%- endif -%}
          {%- if product.type != blank -%}<div><dt>Product type</dt><dd>{{ product.type | escape }}</dd></div>{%- endif -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div><dt>{{ option.name | escape }}</dt><dd>{{ option.values | join: ', ' | escape }}</dd></div>
            {%- endfor -%}
          {%- endunless -%}
          {%- if mf.material != blank -%}<div><dt>Material</dt><dd>{{ mf.material.value | escape }}</dd></div>{%- endif -%}
          {%- if mf.installation != blank -%}<div><dt>Installation</dt><dd>{{ mf.installation.value | escape }}</dd></div>{%- endif -%}
          {%- if mf.cartridge != blank -%}<div><dt>Cartridge</dt><dd>{{ mf.cartridge.value | escape }}</dd></div>{%- endif -%}
          {%- if mf.wels_rating != blank -%}<div><dt>WELS rating</dt><dd>{{ mf.wels_rating.value | escape }}</dd></div>{%- endif -%}
          {%- if mf.flow_rate != blank -%}<div><dt>Flow rate</dt><dd>{{ mf.flow_rate.value | escape }}</dd></div>{%- endif -%}
          {%- if mf.wels_registration != blank -%}<div><dt>WELS registration</dt><dd>{{ mf.wels_registration.value | escape }}</dd></div>{%- endif -%}
        </dl>

        {%- if sku_count > 0 -%}
          {%- comment -%}
            Each code has a "View barcode" button that draws a scannable Code 128 barcode
            (the variant's barcode number if it has one, otherwise the product code).
          {%- endcomment -%}
          <table class="ets-specs__codes">
            <caption>Product codes</caption>
            {%- if product.has_only_default_variant -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              <tbody><tr>
                <th scope="row">Product code</th>
                <td>{{ first_sku | escape }}</td>
                <td class="ets-specs__bc">{% render 'ets-barcode-button', code: variant.barcode, sku: first_sku, label: product.title %}</td>
              </tr></tbody>
            {%- else -%}
              <thead><tr><th scope="col">Option</th><th scope="col">Product code</th><th scope="col"><span class="ets-visually-hidden">Barcode</span></th></tr></thead>
              <tbody>
                {%- for variant in product.variants -%}
                  {%- if variant.sku != blank -%}
                    <tr>
                      <th scope="row">{{ variant.title | escape }}</th>
                      <td>{{ variant.sku | escape }}</td>
                      <td class="ets-specs__bc">{% render 'ets-barcode-button', code: variant.barcode, sku: variant.sku, label: variant.title %}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            {%- endif -%}
          </table>
          <dialog class="ets-barcode" data-ets-barcode aria-labelledby="EtsBarcodeTitle-{{ section.id }}">
            <div class="ets-barcode__head">
              <p class="ets-barcode__title" id="EtsBarcodeTitle-{{ section.id }}"><span>{{ product.title | escape }}</span><strong data-ets-barcode-label></strong></p>
              <button type="button" class="ets-barcode__close" data-ets-barcode-close aria-label="Close">&times;</button>
            </div>
            <div class="ets-barcode__img" data-ets-barcode-img></div>
            <p class="ets-barcode__code" data-ets-barcode-code></p>
          </dialog>
        {%- endif -%}
      </details>

      {%- if has_dimensions -%}
        <details class="ets-specs__item">
          <summary>Dimensions</summary>
          <dl class="ets-specs__list">
            {%- if mf.width_mm != blank -%}<div><dt>Width</dt><dd>{{ mf.width_mm.value }}&nbsp;mm</dd></div>{%- endif -%}
            {%- if mf.height_mm != blank -%}<div><dt>Height</dt><dd>{{ mf.height_mm.value }}&nbsp;mm</dd></div>{%- endif -%}
            {%- if mf.depth_mm != blank -%}<div><dt>Depth</dt><dd>{{ mf.depth_mm.value }}&nbsp;mm</dd></div>{%- endif -%}
            {%- if mf.diameter_mm != blank -%}<div><dt>Diameter</dt><dd>{{ mf.diameter_mm.value }}&nbsp;mm</dd></div>{%- endif -%}
          </dl>
          <p class="ets-specs__note">Always confirm dimensions against the supplier specification sheet before installation.</p>
        </details>
      {%- endif -%}

      {%- if has_care -%}
        <details class="ets-specs__item">
          <summary>Warranty &amp; care</summary>
          <dl class="ets-specs__list">
            {%- if mf.warranty != blank -%}<div><dt>Manufacturer warranty</dt><dd>{{ mf.warranty.value | escape }}</dd></div>{%- endif -%}
          </dl>
          {%- if mf.care != blank -%}<div class="ets-specs__rte">{{ mf.care | metafield_tag }}</div>{%- endif -%}
          <p class="ets-specs__note"><a href="{{ pages['product-care'].url | default: '/pages/product-care' }}">Care &amp; warranty information</a></p>
        </details>
      {%- endif -%}

      {%- if has_downloads -%}
        <details class="ets-specs__item">
          <summary>Downloads</summary>
          <ul class="ets-specs__downloads" role="list">
            {%- if mf.spec_sheet != blank -%}
              <li><a href="{{ mf.spec_sheet.value.url }}" target="_blank" rel="noopener">Specification sheet<span class="visually-hidden"> (opens in a new tab)</span></a></li>
            {%- endif -%}
            {%- if mf.technical_drawing != blank -%}
              <li><a href="{{ mf.technical_drawing.value.url }}" target="_blank" rel="noopener">Technical drawing<span class="visually-hidden"> (opens in a new tab)</span></a></li>
            {%- endif -%}
          </ul>
        </details>
      {%- endif -%}

      <details class="ets-specs__item">
        <summary>Delivery, pickup &amp; returns</summary>
        <ul class="ets-specs__points" role="list">
          {%- if mf.lead_time != blank -%}<li>Lead time: {{ mf.lead_time.value | escape }}</li>{%- endif -%}
          <li>Tiles and large items are delivered across the Perth metro area, and small items ship Australia-wide. Delivery options for your address show at checkout, or contact us for a freight quote.</li>
          <li>Free pickup from {% render 'ets-address-link', text: '17A Olga Road, Maddington' %}, by appointment once we confirm your order is ready.</li>
          <li>Change-of-mind returns within 30 days of receiving your order, for unused products in original packaging. A restocking fee applies.</li>
        </ul>
        <p class="ets-specs__note">
          <a href="{{ pages['delivery-pickup'].url | default: shop.shipping_policy.url }}">Delivery &amp; pickup</a>
          · <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Returns policy</a>
        </p>
      </details>
    </div>
  </div>
</section>

{% stylesheet %}
  .ets-specs{padding:clamp(48px,7vw,96px) 0;background:var(--ets-white,#fff);border-top:1px solid var(--ets-line,rgba(21,33,58,.16))}
  .ets-specs__grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.4fr);gap:clamp(32px,6vw,96px);align-items:start}
  .ets-specs__intro{position:sticky;top:calc(var(--ets-header-h,72px) + 56px)}
  .ets-specs__intro h2{margin:0;color:var(--ets-navy);font-size:clamp(28px,3vw,40px);line-height:1.08;letter-spacing:-.03em}
  .ets-specs__intro p{margin:16px 0 0;max-width:360px;color:var(--ets-muted);font-size:16px;line-height:1.6}
  .ets-specs__intro a,.ets-specs__note a,.ets-specs__downloads a{color:var(--ets-accent);text-underline-offset:3px}
  .ets-specs__panels{border-top:1px solid var(--ets-line)}
  .ets-specs__item{border-bottom:1px solid var(--ets-line)}
  .ets-specs__item>summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:64px;cursor:pointer;list-style:none;color:var(--ets-navy);font-size:18px;font-weight:600}
  .ets-specs__item>summary::-webkit-details-marker{display:none}
  .ets-specs__item>summary::after{content:"";width:12px;height:12px;flex:0 0 auto;border-right:1.6px solid currentColor;border-bottom:1.6px solid currentColor;transform:translateY(-3px) rotate(45deg)}
  .ets-specs__item[open]>summary::after{transform:translateY(3px) rotate(-135deg)}
  .ets-specs__item>:not(summary){margin-bottom:24px}
  .ets-specs__list{margin:0;display:grid}
  .ets-specs__list>div{display:grid;grid-template-columns:minmax(120px,.7fr) 1fr;gap:16px;padding:12px 0;border-top:1px solid var(--ets-line)}
  .ets-specs__list>div:first-child{border-top:0}
  .ets-specs__list dt{color:var(--ets-muted);font-size:15px}
  .ets-specs__list dd{margin:0;color:var(--ets-navy);font-size:15px;overflow-wrap:anywhere}
  .ets-specs__codes{width:100%;margin-top:8px;border-collapse:collapse;font-size:15px}
  .ets-specs__codes caption{text-align:start;padding:16px 0 8px;color:var(--ets-navy);font-weight:600}
  .ets-specs__codes th,.ets-specs__codes td{padding:10px 0;border-top:1px solid var(--ets-line);text-align:start;font-weight:400}
  .ets-specs__codes thead th{color:var(--ets-muted);font-size:13px}
  .ets-specs__codes tbody th{color:var(--ets-muted)}
  .ets-specs__codes td{color:var(--ets-navy);font-variant-numeric:tabular-nums;letter-spacing:.02em}
  .ets-specs__codes td.ets-specs__bc{text-align:end;white-space:nowrap}
  .ets-bc-btn{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 12px;border:1px solid var(--ets-line);border-radius:999px;background:none;color:var(--ets-navy);font:inherit;font-size:13px;font-weight:600;letter-spacing:0;cursor:pointer}
  .ets-bc-btn:hover{border-color:var(--ets-navy)}
  .ets-bc-btn svg{width:16px;height:16px}
  .ets-barcode{width:min(560px,calc(100vw - 32px));padding:20px;border:0;border-radius:16px;background:#fff;color:#000}
  .ets-barcode::backdrop{background:rgba(10,16,30,.6)}
  .ets-barcode__head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
  .ets-barcode__title{margin:0;display:grid;gap:2px;font-size:14px;color:var(--ets-muted)}
  .ets-barcode__title strong{color:var(--ets-navy);font-size:16px}
  .ets-barcode__close{flex:0 0 auto;width:44px;height:44px;margin:-10px -10px 0 0;border:0;background:none;font-size:28px;line-height:1;color:var(--ets-navy);cursor:pointer}
  .ets-barcode__img{margin-top:16px;padding:16px 0;background:#fff}
  .ets-barcode__img svg{display:block;width:100%;height:120px}
  .ets-barcode__code{margin:8px 0 0;text-align:center;font-size:18px;font-weight:600;letter-spacing:.08em;font-variant-numeric:tabular-nums}
  .ets-specs__note{margin:12px 0 0;color:var(--ets-muted);font-size:14px;line-height:1.5}
  .ets-specs__points,.ets-specs__downloads{margin:0;padding:0;list-style:none;display:grid;gap:10px}
  .ets-specs__points li{position:relative;padding-inline-start:18px;color:var(--ets-navy);font-size:15px;line-height:1.55}
  .ets-specs__points li::before{content:"";position:absolute;inset-inline-start:0;top:.7em;width:6px;height:1.5px;background:var(--ets-accent)}
  .ets-specs__downloads a{display:inline-flex;min-height:44px;align-items:center;font-size:15px;font-weight:600}
  .ets-specs__rte{color:var(--ets-navy);font-size:15px;line-height:1.6}
  @media (max-width:749px){
    .ets-bc-btn{padding:0 10px}
    .ets-bc-btn span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
    .ets-bc-btn::after{content:"Barcode"}
  }
  @media (max-width:989px){
    .ets-specs__grid{grid-template-columns:1fr;gap:24px}
    .ets-specs__intro{position:static}
    .ets-specs__item>summary{min-height:56px;font-size:17px}
    .ets-specs__list>div{grid-template-columns:minmax(110px,.8fr) 1fr}
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    // Code 128 set B: bar/space widths by symbol value (103-105 start codes, 106 stop).
    const P = '212222 222122 222221 121223 121322 131222 122213 122312 132212 221213 221312 231212 112232 122132 122231 113222 123122 123221 223211 221132 221231 213212 223112 312131 311222 321122 321221 312212 322112 322211 212123 212321 232121 111323 131123 131321 112313 132113 132311 211313 231113 231311 112133 112331 132131 113123 113321 133121 313121 211331 231131 213113 213311 213131 311123 311321 331121 312113 312311 332111 314111 221411 431111 111224 111422 121124 121421 141122 141221 112214 112412 122114 122411 142112 142211 241211 221114 413111 241112 134111 111242 121142 121241 114212 124112 124211 411212 421112 421211 212141 214121 412121 111143 111341 131141 114113 114311 411113 411311 113141 114131 311141 411131 211412 211214 211232 2331112'.split(' ');

    function svg(text) {
      const vals = [104];
      for (const ch of text) {
        const c = ch.charCodeAt(0);
        if (c < 32 || c > 126) return '';
        vals.push(c - 32);
      }
      const check = vals.reduce((sum, v, i) => sum + v * (i || 1), 0) % 103;
      vals.push(check, 106);
      let x = 10, rects = '';
      vals.forEach((v) => [...P[v]].forEach((w, i) => {
        if (i % 2 === 0) rects += `<rect x="${x}" y="0" width="${w}" height="60"/>`;
        x += +w;
      }));
      return `<svg viewBox="0 0 ${x + 10} 60" preserveAspectRatio="none" role="img" aria-label="Barcode ${text}"><rect width="100%" height="60" fill="#fff"/><g fill="#000" shape-rendering="crispEdges">${rects}</g></svg>`;
    }

    document.addEventListener('click', (event) => {
      const btn = event.target.closest('[data-ets-barcode-open]');
      if (btn) {
        const dialog = btn.closest('.ets-specs').querySelector('[data-ets-barcode]');
        const code = btn.dataset.code;
        dialog.querySelector('[data-ets-barcode-label]').textContent = btn.dataset.label;
        dialog.querySelector('[data-ets-barcode-img]').innerHTML = svg(code);
        dialog.querySelector('[data-ets-barcode-code]').textContent = code;
        dialog.showModal();
        return;
      }
      const dialog = event.target.closest('[data-ets-barcode]');
      if (!dialog) return;
      // Close on the X, or on a tap on the dimmed backdrop (which also targets the dialog element).
      const r = dialog.getBoundingClientRect();
      const outside = event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom;
      if (event.target.closest('[data-ets-barcode-close]') || (event.target === dialog && outside)) dialog.close();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "ETS specifications",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Details & specifications"
    },
    {
      "type": "checkbox",
      "id": "show_help",
      "label": "Show showroom help text",
      "default": true
    },
    {
      "type": "url",
      "id": "help_url",
      "label": "Help link"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "ETS specifications"
    }
  ]
}
{% endschema %}
