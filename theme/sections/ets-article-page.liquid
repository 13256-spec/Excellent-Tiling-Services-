<article class="ets">
  <header class="ets-phero">
    <div class="ets-wrap" style="max-width:980px">
      {%- render 'ets-breadcrumbs', parent_title: blog.title, parent_url: blog.url, current_title: article.title, current_url: article.url -%}
      <h1 class="ets-display" style="font-size:clamp(40px,5.4vw,76px)">{{ article.title | escape }}</h1>
      <p class="ets-small" style="margin-top:16px"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %B %Y' }}</time></p>
    </div>
  </header>
  {%- if article.image -%}
    <div class="ets-wrap"><div class="ets-shell"><div class="ets-core" style="aspect-ratio:16/8">{{ article.image | image_url: width: 1800 | image_tag: widths: '600, 1000, 1400, 1800', sizes: '94vw', loading: 'eager', alt: article.title, style: 'width:100%;height:100%;object-fit:cover' }}</div></div></div>
  {%- endif -%}
  <div class="ets-wrap ets-sec--tight" style="max-width:980px"><div class="ets-rte">{{ article.content }}</div></div>
</article>
<script type="application/ld+json">{{ article | structured_data }}</script>
{% schema %}{"name":"ETS article","settings":[],"presets":[{"name":"ETS article"}]}{% endschema %}
