{% assign featured = section.settings.collection %}{% if featured.products_count > 0 %}<section class="ets-retail-section"><div class="ets-container"><div class="ets-section-head"><div><p class="ets-overline">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="ets-link" href="{{ featured.url }}">View collection {% render 'ets-store-icon', name: 'arrow' %}</a></div><div class="ets-featured-products">{% for item in featured.products limit: 4 %}<a class="ets-featured-product" href="{{ item.url }}">{% if item.featured_image %}<div>{{ item.featured_image | image_url: width: 700 | image_tag: widths: '300, 500, 700', sizes: '(min-width: 750px) 22vw, 45vw', loading: 'lazy' }}</div>{% endif %}<p class="ets-overline">{{ item.vendor | escape }}</p><h3>{{ item.title | escape }}</h3><p>{% assign formatted_price = item.price | money %}{% if item.price_varies %}{{ 'content.price_from' | t: price: formatted_price }}{% else %}{{ formatted_price }}{% endif %}</p></a>{% endfor %}</div></div></section>{% endif %}
{% schema %}
{
  "name": "ETS featured products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The bathroom edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the range"
    }
  ],
  "presets": [
    {
      "name": "ETS featured products"
    }
  ]
}
{% endschema %}
