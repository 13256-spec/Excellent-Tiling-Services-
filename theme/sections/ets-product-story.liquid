{% assign is_tile = false %}{% for item_collection in product.collections %}{% if item_collection.handle == 'tiles' %}{% assign is_tile = true %}{% endif %}{% endfor %}{% assign warranty = product.metafields.ets.warranty.value %}{% assign lead_time = product.metafields.ets.lead_time.value %}{% assign freight_class = product.metafields.ets.freight_class.value %}{% assign selected_variant = product.selected_or_first_available_variant %}<section class="ets-product-story"><div class="ets-product-story__shell">{% if warranty != blank or lead_time != blank or freight_class != blank or selected_variant.sku != blank %}<div class="ets-product-story__specs" aria-label="Product information">{% if selected_variant.sku != blank %}<div><span>Product code</span><strong>{{ selected_variant.sku }}</strong></div>{% endif %}{% if warranty != blank %}<div><span>Warranty</span><strong>{{ warranty }}</strong></div>{% endif %}{% if lead_time != blank %}<div><span>Lead time</span><strong>{{ lead_time }}</strong></div>{% endif %}{% if freight_class != blank %}<div><span>Delivery type</span><strong>{{ freight_class }}</strong></div>{% endif %}</div>{% endif %}<div class="ets-product-story__grid"><article class="ets-product-story__card"><p class="ets-product-story__eyebrow">Product details</p><h2>Made easier to specify.</h2><dl>{% if product.vendor != blank %}<div><dt>Brand</dt><dd>{{ product.vendor }}</dd></div>{% endif %}{% if product.type != blank %}<div><dt>Type</dt><dd>{{ product.type }}</dd></div>{% endif %}{% for option in product.options_with_values %}{% unless option.name == 'Title' %}<div><dt>{{ option.name }}</dt><dd>{{ option.values | join: ', ' }}</dd></div>{% endunless %}{% endfor %}</dl></article><article class="ets-product-story__card ets-product-story__card--dark"><p class="ets-product-story__eyebrow">ETS showroom</p><h2>See products in context.</h2><p>Visit 17A Olga Road, Maddington, WA to discuss product selection, delivery and your renovation project with ETS.</p><div class="ets-product-story__actions"><a href="/pages/contact">Contact showroom</a><a href="/pages/request-a-quote">Request a quote</a></div></article></div>{% if is_tile %}<div class="ets-product-story__calculator" data-ets-tile-calculator><div><p class="ets-product-story__eyebrow">Tile quantity guide</p><h2>Allow for cuts and wastage.</h2><p>Enter the measured area and choose a wastage allowance. This gives you a recommended order area in square metres; final quantities should be checked before purchase.</p></div><div class="ets-product-story__calculator-form"><label><span>Measured area (m²)</span><input type="number" min="0" step="0.01" inputmode="decimal" placeholder="e.g. 18.5" data-ets-area></label><label><span>Wastage allowance</span><select data-ets-waste><option value="10">10%</option><option value="15">15%</option><option value="20">20%</option></select></label><div class="ets-product-story__result"><span>Recommended order area</span><strong data-ets-result>—</strong></div></div></div>{% endif %}<div class="ets-product-story__service"><div><p class="ets-product-story__eyebrow">Need installation?</p><h2>Professional tiling by ETS.</h2></div><div><p>Buying tiles for a renovation? ETS can also help with professional tiling services in Perth.</p><a href="/pages/tiling-services">Explore tiling services <span aria-hidden="true">→</span></a></div></div></div></section>
{% stylesheet %}.ets-product-story{background:#f6f4ef;color:#11110f}.ets-product-story *{box-sizing:border-box}.ets-product-story__shell{width:min(calc(100% - 28px),1540px);margin:0 auto;padding:18px 0 clamp(64px,8vw,112px)}.ets-product-story__eyebrow{margin:0 0 14px;color:#716d65;font-size:11px;letter-spacing:.13em;text-transform:uppercase}.ets-product-story h2{margin:0;font-size:clamp(34px,4vw,62px);line-height:1;letter-spacing:-.045em;font-weight:550}.ets-product-story__specs{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border-radius:22px;overflow:hidden;margin-bottom:14px}.ets-product-story__specs>div{min-height:112px;padding:22px;border-right:1px solid rgba(17,17,15,.08);display:flex;flex-direction:column;justify-content:center;gap:8px}.ets-product-story__specs>div:last-child{border-right:0}.ets-product-story__specs span{color:#79756d;font-size:11px;text-transform:uppercase;letter-spacing:.1em}.ets-product-story__specs strong{font-size:15px;font-weight:600;overflow-wrap:anywhere}.ets-product-story__grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ets-product-story__card{min-height:430px;padding:clamp(34px,5vw,68px);border-radius:26px;background:#fff}.ets-product-story__card--dark{background:#11110f;color:#fff;display:flex;flex-direction:column;justify-content:end}.ets-product-story__card--dark .ets-product-story__eyebrow,.ets-product-story__card--dark>p:not(.ets-product-story__eyebrow){color:rgba(255,255,255,.62)}.ets-product-story__card--dark>p:not(.ets-product-story__eyebrow){max-width:600px;margin:24px 0 0;line-height:1.6;font-size:16px}.ets-product-story dl{margin:36px 0 0}.ets-product-story dl>div{display:grid;grid-template-columns:.6fr 1fr;gap:24px;padding:15px 0;border-bottom:1px solid rgba(17,17,15,.09)}.ets-product-story dt{color:#77736b}.ets-product-story dd{margin:0}.ets-product-story__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.ets-product-story__actions a{min-height:46px;padding:0 18px;display:inline-flex;align-items:center;border-radius:999px;background:#fff;color:#11110f;text-decoration:none;font-size:13px;font-weight:600}.ets-product-story__actions a+a{background:transparent;border:1px solid rgba(255,255,255,.28);color:#fff}.ets-product-story__calculator{margin-top:14px;padding:clamp(34px,5vw,68px);display:grid;grid-template-columns:1fr .9fr;gap:clamp(36px,6vw,90px);border-radius:26px;background:#e7e2d8}.ets-product-story__calculator>div:first-child>p:last-child{max-width:660px;margin:24px 0 0;color:#6b675f;line-height:1.6}.ets-product-story__calculator-form{display:grid;gap:12px;align-content:center}.ets-product-story__calculator label{display:grid;gap:7px}.ets-product-story__calculator label span,.ets-product-story__result span{color:#716d65;font-size:11px;letter-spacing:.08em;text-transform:uppercase}.ets-product-story__calculator input,.ets-product-story__calculator select{width:100%;min-height:54px;padding:0 16px;border:1px solid rgba(17,17,15,.13);border-radius:14px;background:#fff;color:#11110f;font:inherit}.ets-product-story__result{margin-top:6px;padding:20px;border-radius:16px;background:#11110f;color:#fff}.ets-product-story__result span{color:rgba(255,255,255,.6);display:block}.ets-product-story__result strong{display:block;margin-top:8px;font-size:28px;letter-spacing:-.03em}.ets-product-story__service{margin-top:14px;padding:clamp(34px,5vw,68px);display:grid;grid-template-columns:1fr .7fr;gap:50px;background:#fff;border-radius:26px}.ets-product-story__service>div:last-child{align-self:end}.ets-product-story__service>div:last-child p{margin:0 0 20px;color:#6d6961;line-height:1.6}.ets-product-story__service a{color:inherit;text-decoration:none;font-weight:600}@media(max-width:900px){.ets-product-story__specs{grid-template-columns:repeat(2,1fr)}.ets-product-story__specs>div:nth-child(2){border-right:0}.ets-product-story__grid,.ets-product-story__calculator,.ets-product-story__service{grid-template-columns:1fr}.ets-product-story__card{min-height:360px}}@media(max-width:520px){.ets-product-story__specs{grid-template-columns:1fr}.ets-product-story__specs>div{border-right:0;border-bottom:1px solid rgba(17,17,15,.08);min-height:88px}.ets-product-story__specs>div:last-child{border-bottom:0}}{% endstylesheet %}
{% javascript %}document.querySelectorAll('[data-ets-tile-calculator]').forEach(function(calculator){var area=calculator.querySelector('[data-ets-area]');var waste=calculator.querySelector('[data-ets-waste]');var result=calculator.querySelector('[data-ets-result]');function updateResult(){var areaValue=parseFloat(area.value);var wasteValue=parseFloat(waste.value);if(!Number.isFinite(areaValue)||areaValue<=0){result.textContent='—';return}var total=areaValue*(1+(wasteValue/100));result.textContent=total.toFixed(2)+' m²'}area.addEventListener('input',updateResult);waste.addEventListener('change',updateResult)}){% endjavascript %}
{% schema %}{"name":"ETS product story","settings":[]}{% endschema %}