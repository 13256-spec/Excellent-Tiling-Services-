<section class="ets-editorial-section ets-editorial-collections" aria-labelledby="ets-collections-{{ section.id }}">
  <div class="ets-shell">
    <div class="ets-editorial-heading"><div><p class="ets-kicker">{{ section.settings.eyebrow | escape }}</p><h2 id="ets-collections-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div><p>{{ section.settings.description | escape }}</p></div>
    <div class="ets-editorial-collection-list">
      {% for block in section.blocks %}
        {% liquid
          assign category = block.settings.collection
          assign category_image = block.settings.image | default: category.image | default: category.products.first.featured_image
          assign category_title = block.settings.title | default: category.title
          assign category_url = block.settings.url | default: category.url
        %}
        {% if category_title != blank and category_url != blank %}
          <a class="ets-editorial-category" href="{{ category_url }}" {{ block.shopify_attributes }}>
            <span class="ets-editorial-category__number" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span class="ets-editorial-category__name">{{ category_title | escape }}</span>
            <span class="ets-editorial-category__description">{{ block.settings.description | escape }}</span>
            {% if category_image != blank %}<span class="ets-editorial-category__image">{{ category_image | image_url: width: 360 | image_tag: widths: '180, 360', sizes: '120px', loading: 'lazy', alt: '' }}</span>{% endif %}
            <span class="ets-editorial-category__arrow" aria-hidden="true">↗</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"ETS collection index","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The collection"},{"type":"text","id":"heading","label":"Heading","default":"Find your finishing touch."},{"type":"textarea","id":"description","label":"Description","default":"Explore the details that make a room yours. Talk to our team about the range, finishes and your project."}],"max_blocks":8,"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"title","label":"Title override"},{"type":"textarea","id":"description","label":"Short description"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"url","id":"url","label":"Link override"}]}],"presets":[{"name":"ETS collection index"}]}
{% endschema %}
