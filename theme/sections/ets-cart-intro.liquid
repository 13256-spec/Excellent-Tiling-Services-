<section class="ets-cart-intro">
  <div class="ets-cart-intro__shell">
    <div class="ets-cart-intro__copy">
      <p>YOUR PROJECT · ETS</p>
      <h2 class="ets-cart-intro__title">Review the details before checkout.</h2>
      <span>Bathroomware, tiles and project orders can need different delivery arrangements. Your cart stays simple; ETS handles the detail behind it.</span>
      <div class="ets-cart-intro__links"><a href="/pages/delivery-pickup">Delivery & pickup</a><a href="/pages/contact">Need help?</a></div>
    </div>
    <div class="ets-cart-intro__media"><img src="{{ 'ets-flagship-australian-bathroom.jpg' | file_url }}" width="2400" height="1600" alt="Bright modern bathroom with vanity, bath and walk-in shower" fetchpriority="high"></div>
  </div>
  <div class="ets-cart-intro__trust"><div><span>01</span><strong>Maddington fulfilment</strong><p>Orders are packed in Maddington. Pickup is by appointment.</p></div><div><span>02</span><strong>Fragile & project freight</strong><p>Large and fragile items can require specialist delivery.</p></div><div><span>03</span><strong>Professional tiling</strong><p>Need installation too? ETS can help with the project.</p></div></div>
</section>
{% stylesheet %}.ets-cart-intro{background:#f5f3ee;color:#1F3153;padding:14px 14px 0}.ets-cart-intro *{box-sizing:border-box}.ets-cart-intro a{color:inherit;text-decoration:none}.ets-cart-intro__shell{width:min(100%,1560px);min-height:560px;margin:0 auto;display:grid;grid-template-columns:.82fr 1.18fr;border-radius:22px;overflow:hidden;background:#1F3153;color:#fff}.ets-cart-intro__copy{padding:clamp(38px,6vw,86px);display:flex;flex-direction:column;justify-content:end}.ets-cart-intro__copy>p{margin:0 0 16px;color:rgba(255,255,255,.52);font-size:11px;letter-spacing:.14em}.ets-cart-intro .ets-cart-intro__title{margin:0;max-width:760px;font-size:clamp(48px,5.6vw,88px);line-height:.96;letter-spacing:-.025em;font-weight:500;font-family:var(--font-heading--family)}.ets-cart-intro__copy>span{max-width:610px;margin-top:24px;color:rgba(255,255,255,.67);font-size:15px;line-height:1.65}.ets-cart-intro__links{display:flex;flex-wrap:wrap;gap:9px;margin-top:28px}.ets-cart-intro__links a{min-height:46px;padding:0 18px;border:1px solid rgba(255,255,255,.25);border-radius:999px;display:inline-flex;align-items:center;font-size:13px;font-weight:600}.ets-cart-intro__links a:first-child{background:#fff;color:#1F3153;border-color:#fff}.ets-cart-intro__media{min-height:560px}.ets-cart-intro__media img{width:100%;height:100%;object-fit:cover;display:block}.ets-cart-intro__trust{width:min(100%,1560px);margin:14px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.ets-cart-intro__trust>div{padding:25px;border-radius:22px;background:#fff}.ets-cart-intro__trust span{display:block;margin-bottom:18px;color:#8A8578;font-size:10px}.ets-cart-intro__trust strong{display:block;font-size:15px}.ets-cart-intro__trust p{margin:7px 0 0;color:#56606B;font-size:12px;line-height:1.5}@media(max-width:900px){.ets-cart-intro__shell{grid-template-columns:1fr}.ets-cart-intro__media{order:-1;min-height:52vw}.ets-cart-intro__trust{grid-template-columns:1fr}}@media(max-width:600px){.ets-cart-intro{padding-left:10px;padding-right:10px}.ets-cart-intro__copy{padding:38px 22px}.ets-cart-intro__media{min-height:480px}}{% endstylesheet %}{% schema %}{"name":"ETS cart intro","tag":"section","settings":[],"presets":[{"name":"ETS cart intro"}]}{% endschema %}