<section class="ets ets-sec{% if section.settings.bg == 'sand' %} ets-sec--sand{% elsif section.settings.bg == 'white' %} ets-sec--white{% endif %}" aria-labelledby="EtsCats-{{ section.id }}">
  <div class="ets-wrap">
    <div class="ets-head">
      <div data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="ets-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="ets-h2" id="EtsCats-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="ets-lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="ets-link" href="{{ section.settings.link | default: routes.collections_url }}" data-reveal>{{ section.settings.link_label | escape }} {% render 'ets-icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="ets-cats">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image
          assign contain = false
          if img == blank and c != blank
            assign img = c.image | default: c.products.first.featured_image
            assign contain = true
          endif
          if block.settings.fit == 'contain'
            assign contain = true
          elsif block.settings.fit == 'cover'
            assign contain = false
          endif
          assign title = block.settings.title | default: c.title
          comment
            sizes match the rendered tiles (2-up on mobile, 4-up on laptops), so phones stop
            downloading images 2x bigger than the box they fill.
          endcomment
          assign sizes = '(min-width: 990px) 25vw, 45vw'
          if block.settings.size == 'lg'
            assign sizes = '(min-width: 990px) 50vw, 92vw'
          endif
        -%}
        <a class="ets-cat ets-shell{% if block.settings.size == 'lg' %} ets-cat--lg{% elsif block.settings.size == 'md' %} ets-cat--md{% endif %}" href="{{ block.settings.link | default: c.url }}" {{ block.shopify_attributes }} data-reveal style="--d:{{ forloop.index0 | times: 0.05 }}s">
          <div class="ets-core">
            <div class="ets-cat__img{% if contain %} ets-cat__img--contain{% endif %}">
              {%- if img != blank -%}
                {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 400, 600, 900, 1200', sizes: sizes, alt: '' }}
              {%- endif -%}
            </div>
            <div class="ets-cat__body">
              <div>
                <strong>{{ title | escape }}</strong>
                {%- if block.settings.subtitle != blank -%}<small>{{ block.settings.subtitle | escape }}</small>{%- elsif c.products_count > 0 -%}<small>{{ c.products_count }} {{ c.products_count | pluralize: "product", "products" }}</small>{%- endif -%}
              </div>
              <span class="ets-cat__go">{% render 'ets-icon', name: 'arrow-up-right' %}</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- comment -%} On the two-column mobile grid, a large first tile fills its own row; stretch a leftover last tile so the grid ends without a gap. {%- endcomment -%}
<style>
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .ets-cat--lg:first-child ~ .ets-cat:last-child:nth-child(even) { grid-column: span 2; }
  }
</style>
{% schema %}
{
  "name": "ETS category grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by department" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Everything for the <em>bathroom</em>, in one place." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All departments" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "bg", "label": "Background", "default": "none", "options": [{ "value": "none", "label": "Stone" }, { "value": "sand", "label": "Sand" }, { "value": "white", "label": "White" }] }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "select", "id": "size", "label": "Tile size", "default": "sm", "options": [{ "value": "lg", "label": "Large" }, { "value": "md", "label": "Medium" }, { "value": "sm", "label": "Small" }] },
        { "type": "select", "id": "fit", "label": "Image fit", "default": "auto", "options": [{ "value": "auto", "label": "Automatic" }, { "value": "cover", "label": "Fill" }, { "value": "contain", "label": "Fit (product cut-outs)" }] }
      ]
    }
  ],
  "presets": [{ "name": "ETS category grid" }]
}
{% endschema %}
