<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  function initCollection16_{{ section.id | replace: '-', '' }}() {
    var sectionId = '{{ section.id }}';

    function recalcCardHeights(card) {
      var textWrap = card.querySelector('.collection-card-text-wrap-' + sectionId);
      var featuresWrap = card.querySelector('.collection-card-features-wrap-' + sectionId);

      if (textWrap) {
        card.style.setProperty('--text-height', textWrap.scrollHeight + 'px');
      }

      if (featuresWrap) {
        var prevMax = featuresWrap.style.maxHeight;
        featuresWrap.style.maxHeight = 'none';
        card.style.setProperty('--features-height', featuresWrap.scrollHeight + 'px');
        featuresWrap.style.maxHeight = prevMax;
      }
    }

    document.querySelectorAll('.collection-card-' + sectionId).forEach(function(card) {
      recalcCardHeights(card);
    });

    if (window.ResizeObserver) {
      var ro = new ResizeObserver(function() {
        document.querySelectorAll('.collection-card-' + sectionId).forEach(function(card) {
          recalcCardHeights(card);
        });
      });
      var sectionEl = document.querySelector('.section-' + sectionId);
      if (sectionEl) ro.observe(sectionEl);
    }

    document.querySelectorAll('.collection-card-' + sectionId).forEach(function(card) {
      var previewEl = card.querySelector('.collection-card-preview-' + sectionId);
      if (!previewEl) return;
      var previewVideo = previewEl.querySelector('video');
      if (!previewVideo) return;

      card.addEventListener('mouseenter', function() {
        if (card.classList.contains('is-playing')) return;
        previewVideo.currentTime = 0;
        previewVideo.play().catch(function() {});
      });

      card.addEventListener('mouseleave', function() {
        previewVideo.pause();
        previewVideo.currentTime = 0;
      });
    });

    function playPreview(card) {
      if (card.classList.contains('is-playing')) return;
      var previewEl = card.querySelector('.collection-card-preview-' + sectionId);
      if (!previewEl) return;
      var pv = previewEl.querySelector('video');
      if (pv) { pv.currentTime = 0; pv.play().catch(function() {}); }
    }

    function pausePreview(card) {
      var previewEl = card.querySelector('.collection-card-preview-' + sectionId);
      if (!previewEl) return;
      var pv = previewEl.querySelector('video');
      if (pv) { pv.pause(); pv.currentTime = 0; }
    }

    function toggleExpandCard(card) {
      if (card.classList.contains('is-expanded')) {
        card.classList.remove('is-expanded');
        pausePreview(card);
      } else {
        document.querySelectorAll('.collection-card-' + sectionId + '.is-expanded').forEach(function(other) {
          other.classList.remove('is-expanded');
          pausePreview(other);
        });
        card.classList.add('is-expanded');
        playPreview(card);
      }
    }

    document.querySelectorAll('.collection-plus-trigger-' + sectionId).forEach(function(plusBtn) {
      plusBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var card = plusBtn.closest('.collection-card-' + sectionId);
        if (card) toggleExpandCard(card);
      });
    });

    document.querySelectorAll('.collection-card-' + sectionId).forEach(function(card) {
      card.addEventListener('click', function(e) {
        if (e.target.closest('.collection-video-trigger-' + sectionId)) return;
        if (e.target.closest('.collection-video-close-' + sectionId)) return;
        if (e.target.closest('.collection-card-video-' + sectionId)) return;
        if (e.target.closest('.collection-plus-trigger-' + sectionId)) return;

        if (window.innerWidth < 1024) {
          if (e.target.closest('.collection-button-' + sectionId)) return;
          if (card.classList.contains('is-expanded') && e.target.closest('.collection-card-content-' + sectionId)) {
            var btn = card.querySelector('.collection-button-' + sectionId);
            if (btn && btn.tagName === 'A' && btn.href) {
              if (btn.target === '_blank') {
                window.open(btn.href, '_blank');
              } else {
                window.location.href = btn.href;
              }
            }
          }
        } else {
          if (!e.target.closest('.collection-card-content-' + sectionId)) return;
          var btn = card.querySelector('.collection-button-' + sectionId);
          if (btn && btn.tagName === 'A' && btn.href) {
            if (btn.target === '_blank') {
              window.open(btn.href, '_blank');
            } else {
              window.location.href = btn.href;
            }
          }
        }
      });
    });

    document.querySelectorAll('.collection-video-trigger-' + sectionId).forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var card = trigger.closest('.collection-card-' + sectionId);
        if (!card) return;

        var videoPanel = card.querySelector('.collection-card-video-' + sectionId);
        if (!videoPanel) return;

        document.querySelectorAll('.collection-card-' + sectionId + '.is-playing').forEach(function(other) {
          if (other === card) return;
          other.classList.remove('is-playing');
          other.classList.remove('is-expanded');
          var otherPanel = other.querySelector('.collection-card-video-' + sectionId);
          if (otherPanel) {
            var otherVideo = otherPanel.querySelector('video');
            var otherIframe = otherPanel.querySelector('iframe');
            if (otherVideo) { otherVideo.pause(); otherVideo.currentTime = 0; }
            if (otherIframe) { otherIframe.src = 'about:blank'; }
          }
          var otherPreview = other.querySelector('.collection-card-preview-' + sectionId);
          if (otherPreview) {
            var pv = otherPreview.querySelector('video');
            if (pv) pv.pause();
          }
        });

        var previewEl = card.querySelector('.collection-card-preview-' + sectionId);
        if (previewEl) {
          var previewVideo = previewEl.querySelector('video');
          if (previewVideo) previewVideo.pause();
        }

        card.classList.add('is-playing');

        var videoTag = videoPanel.querySelector('video');
        var iframeTag = videoPanel.querySelector('iframe');

        if (videoTag) {
          videoTag.currentTime = 0;
          videoTag.play().catch(function() {});
        }
        if (iframeTag && iframeTag.dataset.src) {
          iframeTag.src = iframeTag.dataset.src;
        }
      });
    });

    document.querySelectorAll('.collection-video-close-' + sectionId).forEach(function(closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var card = closeBtn.closest('.collection-card-' + sectionId);
        if (!card) return;

        card.classList.remove('is-playing');
        card.classList.remove('is-expanded');

        var videoPanel = card.querySelector('.collection-card-video-' + sectionId);
        if (!videoPanel) return;

        var videoTag = videoPanel.querySelector('video');
        var iframeTag = videoPanel.querySelector('iframe');

        if (videoTag) {
          videoTag.pause();
          videoTag.currentTime = 0;
        }
        if (iframeTag) {
          iframeTag.src = 'about:blank';
        }
      });
    });

    var sliderWrap = document.querySelector('.collection-slider-wrap-' + sectionId);
    var sliderEl = document.querySelector('.collection-slider-' + sectionId);

    if (sliderEl && sliderWrap && window.getComputedStyle(sliderWrap).display !== 'none') {
      sliderEl.classList.remove('preview');
      new Swiper('.collection-slider-' + sectionId, {
        speed: 300,
        navigation: {
          nextEl: `.slider-btn-next-{{ section.id }}`,
          prevEl: `.slider-btn-prev-{{ section.id }}`,
        },
        scrollbar: {
          el: '.collection-scrollbar-' + sectionId,
          draggable: true,
        },
        breakpoints: {
          320: {
            spaceBetween: parseInt(sliderEl.dataset.gapMobile) || 0,
            slidesPerView: parseFloat(sliderEl.dataset.viewMobile) || 1,
          },
          1024: {
            spaceBetween: parseInt(sliderEl.dataset.gap) || 0,
            slidesPerView: parseFloat(sliderEl.dataset.view) || 3,
          }
        },
        on: {
          init: function() {
            this.el.style.opacity = '1';
          }
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initCollection16_{{ section.id | replace: '-', '' }});

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', function(e) {
      if (e.detail.sectionId !== '{{ section.id }}') return;
      document.querySelectorAll('.collection-card-{{ section.id }}.is-playing').forEach(function(card) {
        card.classList.remove('is-playing');
      });
    });
    document.addEventListener('shopify:section:load', initCollection16_{{ section.id | replace: '-', '' }});
  }
</script>{%- elsif request.design_mode -%}
