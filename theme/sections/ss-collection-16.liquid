{%- style -%}
  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  /* ---- Grid ---- */
  .collection-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: {{ cards_gap_mobile }}px;
  }

  /* ---- Slider ---- */
  .collection-slider-wrap-{{ section.id }} {
    position: relative;
  }

  .collection-slider-{{ section.id }} {
    margin-left: -{{ padding_horizontal_mobile }}rem !important;
    margin-right: -{{ padding_horizontal_mobile }}rem !important;
    padding-left: {{ padding_horizontal_mobile }}rem !important;
    padding-right: {{ padding_horizontal_mobile }}rem !important;
  }

  .collection-slider-{{ section.id }}.preview .swiper-wrapper {
    display: flex;
    gap: {{ cards_gap_mobile }}px;
    overflow: hidden;
  }

  .collection-slider-{{ section.id }}.preview .collection-card-{{ section.id }} {
    flex-shrink: 0;
    width: calc(100% / {{ slider_view_mobile }} - {{ cards_gap_mobile }}px);
  }

  .collection-card-{{ section.id }} {
    position: relative;
    border-radius: {{ card_radius }}px;
    overflow: hidden;
    cursor: default;
  }

  .collection-card-image-{{ section.id }} {
    width: 100%;
    display: block;
    position: relative;
    aspect-ratio: 2/3;
  }

  .collection-card-image-{{ section.id }} img,
  .collection-card-image-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease 0s;
  }

  .collection-card-image-{{ section.id }} svg {
    background-color: #EFEFEF;
  }

  .collection-card-preview-{{ section.id }} {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s ease 0s;
    pointer-events: none;
    z-index: 1;
  }

  .collection-card-preview-{{ section.id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-card-video-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 10;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease 0s;
    display: block !important;
  }

  .collection-card-{{ section.id }}.is-playing .collection-card-video-{{ section.id }} {
    opacity: 1;
    pointer-events: all;
    cursor: default;
  }

  .collection-card-video-{{ section.id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-card-video-{{ section.id }} iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .collection-video-close-{{ section.id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    width: {{ video_close_size }}px;
    height: {{ video_close_size }}px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #FFFFFF;
    padding: 0;
    z-index: 1;
    transition: all 0.25s ease 0s;
  }

  .collection-video-close-{{ section.id }}:hover {
    background: rgba(255,255,255,0.25);
  }

  .collection-video-close-{{ section.id }} svg {
    width: 50%;
    height: 50%;
  }

  .collection-card-overlay-grid-{{ section.id }} {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 1fr max-content;
    z-index: 2;
    transition: opacity 0.3s ease 0s;
  }

  .collection-card-{{ section.id }}.is-playing .collection-card-overlay-grid-{{ section.id }},
  .collection-card-{{ section.id }}.is-playing .collection-card-preview-{{ section.id }} {
    opacity: 0;
    pointer-events: none;
  }

  .collection-card-top-row-{{ section.id }} {
    position: relative;
    display: block !important;
  }

  .collection-card-overlay-{{ section.id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: {{ overlay_height }}%;
    background: linear-gradient(to top, {{ overlay_color | color_modify: 'alpha', overlay_opacity }} 0%, transparent 100%);
    z-index: 1;
    pointer-events: none;
    transition: opacity 0.35s ease 0s;
    display: block !important;
  }

  .collection-card-content-{{ section.id }} {
    position: relative;
    padding: {{ content_padding_vertical_mobile }}px {{ content_padding_horizontal_mobile }}px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ content_flex_align_mobile }};
    text-align: {{ content_align_mobile }};
    cursor: pointer;
  }

  .collection-card-content-bg-{{ section.id }} {
    position: absolute;
    inset: 0;
    top: auto;
    bottom: 0;
    height: 0;
    background: {{ hover_bg_color }};
    transition: height 0.45s ease 0s;
    z-index: -1;
    display: block !important;
  }

  .collection-card-title-{{ section.id }} {
    font-size: {{ title_size_mobile }}px;
    color: {{ title_color }};
    line-height: {{ title_height }}%;
    margin: 0;
    font-weight: 700;
    position: relative;
    z-index: 1;
  }

  .collection-card-text-wrap-{{ section.id }} {
    max-height: var(--text-height, 300px);
    overflow: hidden;
    transition: max-height 0.35s ease 0s;
  }

  .collection-card-text-{{ section.id }} * {
    font-size: {{ text_size_mobile }}px;
    color: {{ text_color }};
    line-height: {{ text_height }}%;
    margin: 0;
  }

  .collection-card-features-wrap-{{ section.id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s ease 0s;
  }

  .collection-card-features-{{ section.id }} {
    list-style: none;
    margin: {{ features_mt_mobile }}px 0 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ features_gap }}px;
    align-items: {{ content_flex_align_mobile }};
  }

  .collection-card-features-{{ section.id }} li {
    font-size: {{ features_size_mobile }}px;
    color: {{ features_color }};
    line-height: {{ features_height }}%;
    margin: 0;
    display: flex;
    align-items: center;
    {% if content_align_mobile == 'right' %}
      flex-direction: row-reverse;
    {% else %}
      flex-direction: row;
    {% endif %}
    gap: 8px;
  }

  .collection-video-trigger-{{ section.id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
    transition: opacity 0.35s ease 0s, transform 0.35s ease 0s;
    z-index: 2;
    cursor: pointer;
    width: {{ video_trigger_size_mobile }}px;
    height: {{ video_trigger_size_mobile }}px;
    border-radius: 50%;
    background: {{ video_trigger_bg }};
    border: {{ video_trigger_border_thickness }}px solid {{ video_trigger_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ video_trigger_color }};
    padding: 0;
    outline: none;
  }

  .collection-video-trigger-{{ section.id }} svg {
    width: 40%;
    height: 40%;
    margin-left: 3px;
  }

  .collection-button-{{ section.id }} {
    position: relative;
    text-decoration: none;
    margin-top: {{ button_mt_mobile }}px;
    display: block;
    width: fit-content;
    z-index: 1;
  }

  .collection-button-inner-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: fit-content;
    gap: 10px;
    width: 100%;
    margin: 0;
    font-size: {{ button_size_mobile }}px;
    color: {{ button_color }};
    line-height: {{ button_height }}%;
    text-align: center;
    text-decoration: none;
    padding: {{ button_padding_vertical_mobile }}px {{ button_padding_horizontal_mobile }}px;
    border-radius: {{ button_radius }}px;
    transition: all 0.25s ease 0s;
    background-color: transparent;
    border: 0px;
    cursor: pointer;
  }

  .collection-button-inner-{{ section.id }} svg {
    width: 14px !important;
    height: 14px !important;
    background: transparent;
    min-height: auto !important;
  }

  .collection-button-inner-{{ section.id }} svg path {
    fill: {{ button_color }};
    transition: all 0.25s ease 0s;
  }

  .collection-button-inner-{{ section.id }}:hover {
    color: {{ button_hover_color }};
    transition: all 0.25s ease 0s;
  }

  .collection-button-inner-{{ section.id }}:hover svg path {
    fill: {{ button_hover_color }};
    transition: all 0.25s ease 0s;
  }

  .slider-btn-prev-{{ section.id }},
  .slider-btn-next-{{ section.id }} {
    display: flex;   
    position: absolute;
    z-index: 2;
    top: 47%;
    transform: translateY(-50%);
    flex-shrink: 0;
    width: {{ arrow_size_mobile }}px;
    height: {{ arrow_size_mobile }}px;
    border: 0px;
    border: {{ arrow_border_thickness }}px solid {{ arrow_border_color }};
    border-radius: {{ arrow_radius }}px;
    background: transparent;
    background: {{ arrow_bg_color }};
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease 0s;
    cursor: pointer;
    -webkit-appearance: none;
    box-shadow: 0px 0px 10px 0px rgba(0,0,0,.15);
  }

  .slider-btn-prev-{{ section.id }} {
    left: 5%;
  }

  .slider-btn-next-{{ section.id }} {
    right: 5%;
  }

  .slider-btn-prev-{{ section.id }} .animate-icon,
  .slider-btn-next-{{ section.id }} .animate-icon {
    pointer-events: none;
    place-items: center;
    display: grid;
  }

  .slider-btn-prev-{{ section.id }} .animate-icon:before,
  .slider-btn-next-{{ section.id }} .animate-icon:before {
    content: "";
    grid-area: 1 / -1;
    transition: all .2s ease;
    width: {{ arrow_icon_size_mobile }}px;
    height: {{ arrow_icon_size_mobile }}px;
    transform: rotate(calc(1 * 45deg));
    box-sizing: border-box;
    border-style: solid;
    border: 0px;
    border-right: 2px solid currentColor;
    border-top: 2px solid currentColor;
    position: relative;
    left: -1px;
  }

  .slider-btn-prev-{{ section.id }} .animate-icon:before {
    left: unset;
    right: -1px;
    border-right: 0px;
    border-top: 0px;
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
  }

  .slider-btn-prev-{{ section.id }} .animate-icon:after,
  .slider-btn-next-{{ section.id }} .animate-icon:after {
    content: "";
    grid-area: 1 / -1;
    transition: all .2s ease;
    width: {{ arrow_icon_size_mobile | minus: 0.3 }}px;
    height: 1.6px;
    transform-origin: center;
    opacity: 0;
    background: currentColor;
    transform: scaleX(.5);
  }

  .slider-btn-prev-{{ section.id }} span,
  .slider-btn-next-{{ section.id }} span {
    color: {{ arrow_color }};
  }

  .slider-btn-prev-{{ section.id }}.swiper-button-disabled,
  .slider-btn-next-{{ section.id }}.swiper-button-disabled {
    opacity: 0;
  }

  .collection-card-{{ section.id }}.is-expanded .collection-card-content-bg-{{ section.id }} {
    height: 100%;
  }
  .collection-card-{{ section.id }}.is-expanded .collection-card-text-wrap-{{ section.id }} {
    max-height: 0 !important;
  }
  .collection-card-{{ section.id }}.is-expanded .collection-card-features-wrap-{{ section.id }} {
    max-height: var(--features-height, 200px);
  }
  .collection-card-{{ section.id }}.is-expanded .collection-video-trigger-{{ section.id }} {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .collection-card-{{ section.id }}.is-expanded .collection-card-overlay-{{ section.id }} {
    opacity: 0;
  }
  .collection-card-{{ section.id }}.is-expanded .collection-card-preview-{{ section.id }} {
    opacity: 1;
  }
  .collection-card-{{ section.id }}.is-expanded .collection-card-image-{{ section.id }} img {
    transform: scale(1.04);
  }

  /* ---- Text row: text + plus trigger inline ---- */
  .collection-card-text-row-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 12px;
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255,255,255,0.5);
    border-bottom: 1px solid rgba(255,255,255,0.5);
    margin-top: {{ text_mt_mobile }}px;
    padding-top: 12px;
    padding-bottom: 12px;
    transition: all 0.35s ease;
    {% if content_align_mobile == 'right' %}
      flex-direction: row-reverse;
    {% else %}
      flex-direction: row;
    {% endif %}
  }

  .collection-card-{{ section.id }}.is-expanded .collection-card-text-row-{{ section.id }} {
    padding: 0;
    margin: 0;
     transition: all 0.35s ease;
  }

  .collection-card-{{ section.id }}.is-expanded .collection-card-text-row-{{ section.id }} {
    border-color: transparent;
    position: static;
  }
  .collection-card-{{ section.id }}.is-expanded .collection-plus-trigger-{{ section.id }} {
    position: absolute;
    top: 10px;
    {% if content_align_mobile == 'right' %}
      left: 10px;
    {% else %}
      right: 10px;
    {% endif %}
    z-index: 10;
  }

  /* ---- Plus trigger (mobile expand button) ---- */
  .collection-plus-trigger-{{ section.id }} {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    color: {{ title_color }};
    -webkit-appearance: none;
    outline: none;
    flex-shrink: 0;
    transition: opacity 0.25s ease;
  }

  .collection-plus-trigger-{{ section.id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .collection-plus-trigger-{{ section.id }} svg {
    width: 12px;
    height: 12px;
    display: block;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .collection-card-{{ section.id }}.is-expanded .collection-plus-trigger-{{ section.id }} svg {
    transform: rotate(45deg);
  }

  @media(min-width: 1024px) {
    .collection-plus-trigger-{{ section.id }} {
      display: none;
    }
  }

  @media(min-width: 1024px) {

    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-left: {{ margin_horizontal }}rem;
      margin-right: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
    }

    .section-{{ section.id }}-settings {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .collection-slider-{{ section.id }} {
      margin-left: -{{ padding_horizontal }}rem !important;
      margin-right: -{{ padding_horizontal }}rem !important;
      padding-left: {{ padding_horizontal }}rem !important;
      padding-right: {{ padding_horizontal }}rem !important;
    }

    .collection-card-{{ section.id }}:hover .collection-card-image-{{ section.id }} img {
      transform: scale(1.04);
    }

    .collection-card-{{ section.id }}:hover .collection-card-preview-{{ section.id }} {
      opacity: 1;
    }

    .collection-card-{{ section.id }}:hover .collection-card-overlay-{{ section.id }} {
      opacity: 0;
    }

    .collection-card-{{ section.id }}:hover .collection-card-content-bg-{{ section.id }} {
      height: 100%;
    }

    .collection-card-{{ section.id }}:hover .collection-card-text-wrap-{{ section.id }} {
      max-height: 0 !important;
    }

    .collection-card-text-wrap-{{ section.id }} {
      width: 100%;
    }

    .collection-card-{{ section.id }}:hover .collection-card-features-wrap-{{ section.id }} {
      max-height: var(--features-height, 200px);
    }

    .collection-card-{{ section.id }}:hover .collection-video-trigger-{{ section.id }} {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    .collection-card-{{ section.id }}.is-playing:hover .collection-video-trigger-{{ section.id }} {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0);
    }

    .collection-grid-{{ section.id }} {
      grid-template-columns: repeat({{ cards_per_row }}, 1fr);
      gap: {{ cards_gap }}px;
    }

    .collection-slider-{{ section.id }}.preview .collection-card-{{ section.id }} {
      width: calc(100% / {{ slider_view }} - {{ cards_gap }}px);
    }

    .collection-slider-{{ section.id }}.preview .swiper-wrapper {
      gap: {{ cards_gap }}px;
    }

    .collection-card-content-{{ section.id }} {
      padding: {{ content_padding_vertical }}px {{ content_padding_horizontal }}px;
      align-items: {{ content_flex_align }};
      text-align: {{ content_align }};
    }

    .collection-card-features-{{ section.id }} {
      margin-top: {{ features_mt }}px;
      align-items: {{ content_flex_align }};
    }

    .collection-card-title-{{ section.id }} {
      font-size: {{ title_size }}px;
    }

    .collection-card-text-{{ section.id }} {
      margin-top: {{ text_mt }}px;
    }

    .collection-card-text-{{ section.id }} * {
      font-size: {{ text_size }}px;
    }

    .collection-card-features-{{ section.id }} li {
      font-size: {{ features_size }}px;
      {% if content_align == 'right' %}
        flex-direction: row-reverse;
      {% else %}
        flex-direction: row;
      {% endif %}
    }

    .collection-button-{{ section.id }} {
      margin-top: {{ button_mt }}px;
    }

    .collection-button-inner-{{ section.id }} {
      padding: {{ button_padding_vertical }}px {{ button_padding_horizontal }}px;
      font-size: {{ button_size }}px;
    }

    .collection-video-trigger-{{ section.id }} {
      width: {{ video_trigger_size }}px;
      height: {{ video_trigger_size }}px;
    }

    .collection-card-text-row-{{ section.id }} {
      border: 0px;
      margin: 0;
      padding: 0;
    }

    .slider-btn-prev-{{ section.id }},
    .slider-btn-next-{{ section.id }} {
      width: {{ arrow_size }}px;
      height: {{ arrow_size }}px;
      transition: all 0.25s ease 0s;
    }

    .slider-btn-prev-{{ section.id }} .animate-icon:before,
    .slider-btn-next-{{ section.id }} .animate-icon:before {
      width: {{ arrow_icon_size }}px;
      height: {{ arrow_icon_size }}px;
    }

    .slider-btn-prev-{{ section.id }} .animate-icon:after,
    .slider-btn-next-{{ section.id }} .animate-icon:after {
      width: {{ arrow_icon_size | minus: 0.3 }}px;
    } 
  }

  @media(min-width: 1024px) and (max-width: 1199px) {
    .collection-grid-{{ section.id }} {
      grid-template-columns: repeat({{ cards_per_row_tablet }}, 1fr);
    }
  }

  /* ---- Scrollbar (mobile) ---- */
  .collection-scrollbar-{{ section.id }} {
    position: relative !important;
    left: auto !important;
    bottom: auto !important;
    width: 100% !important;
    height: {{ scrollbar_height }}px !important;
    border-radius: {{ scrollbar_radius }}px !important;
    background: {{ scrollbar_color }} !important;
    margin-top: {{ scrollbar_mt }}px;
    box-sizing: border-box;
  }

  .collection-scrollbar-{{ section.id }} .swiper-scrollbar-drag {
    display: block !important;
    background: {{ scrollbar_drag_color }} !important;
    border-radius: {{ scrollbar_radius }}px !important;
    height: 100% !important;
    cursor: grab;
  }

  @media(min-width: 1024px) {
    .collection-scrollbar-{{ section.id }} {
      display: none !important;
    }
  }

  /* ---- Video title overlay ---- */
  .collection-video-title-{{ section.id }} {
    position: absolute;
    bottom: {{ video_title_bottom }}px;
    left: 0;
    right: 0;
    padding: 20px 20px 22px;
    color: {{ video_title_color }};
    font-size: {{ video_title_size_mobile }}px;
    font-weight: 700;
    line-height: {{ video_title_height }}%;
    z-index: 2;
    pointer-events: none;
    margin: 0;
  }

  @media(min-width: 1024px) {
    .collection-video-title-{{ section.id }} {
      font-size: {{ video_title_size }}px;
    }
  }

{%- endstyle -%}

