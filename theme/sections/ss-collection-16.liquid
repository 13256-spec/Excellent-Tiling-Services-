{% schema %}
{
  "name": "SS - Collection #16",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "default": "slider",
      "options": [
        { "label": "Grid", "value": "grid" },
        { "label": "Slider", "value": "slider" }
      ]
    },
    {
      "type": "select",
      "id": "layout_type_mobile",
      "label": "Layout - mobile",
      "default": "slider",
      "options": [
        { "label": "Grid", "value": "grid" },
        { "label": "Slider", "value": "slider" }
      ]
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Cards per row",
      "default": 3,
      "info": "The layout is responsive",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "slider_view",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "label": "Cards to show",
      "default": 3,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "range",
      "id": "slider_view_mobile",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "label": "Cards to show - mobile",
      "default": 1.2,
      "visible_if": "{{ section.settings.layout_type_mobile == 'slider' }}"
    },
    {
      "type": "range",
      "id": "cards_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 16
    },
    {
      "type": "range",
      "id": "cards_gap_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Gap - mobile",
      "default": 12
    },
    {
      "type": "header",
      "content": "Arrows"
    },
    {
      "type": "checkbox",
      "id": "arrow_show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "arrow_show_mobile",
      "label": "Show on mobile",
      "default": false
    }, 
    {
      "type": "range",
      "id": "arrow_size",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 48,
      "visible_if": "{{ section.settings.arrow_show_desktop }}"
    },
    {
      "type": "range",
      "id": "arrow_size_mobile",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Size - mobile",
      "default": 48,
      "visible_if": "{{ section.settings.arrow_show_mobile }}"
    },
    {
      "type": "range",
      "id": "arrow_icon_size",
      "min": 5,
      "max": 15,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 10,
      "visible_if": "{{ section.settings.arrow_show_desktop }}"
    },
    {
      "type": "range",
      "id": "arrow_icon_size_mobile",
      "min": 5,
      "max": 15,
      "step": 1,
      "unit": "px",
      "label": "Icon size - mobile",
      "default": 10,
      "visible_if": "{{ section.settings.arrow_show_mobile }}"
    },
    {
      "type": "range",
      "id": "arrow_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 0,
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}"
    },
    {
      "type": "range",
      "id": "arrow_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Roundness",
      "default": 100,
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}"
    },
    {
      "type": "select",
      "id": "arrow_hover_effect",
      "label": "Hover effect",
      "default": "color",
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}",
      "options": [
        {
          "label": "Change color",
          "value": "color"
        },
        {
          "label": "Change size",
          "value": "scale"
        },
        {
          "label": "Change arrow",
          "value": "arrow"
        },
        {
          "label": "None",
          "value": "none"
        }
      ]
    },    
    {
      "type": "header",
      "content": "Scrollbar (mobile)",
      "visible_if": "{{ section.settings.layout_type_mobile == 'slider' }}"
    },
    {
      "type": "range",
      "id": "scrollbar_height",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "Height",
      "default": 3,
      "visible_if": "{{ section.settings.layout_type_mobile == 'slider' }}"
    },
    {
      "type": "range",
      "id": "scrollbar_radius",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Roundness",
      "default": 4,
      "visible_if": "{{ section.settings.layout_type_mobile == 'slider' }}"
    },
    {
      "type": "range",
      "id": "scrollbar_mt",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margin top",
      "default": 16,
      "visible_if": "{{ section.settings.layout_type_mobile == 'slider' }}"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Roundness",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text_alignment",
      "id": "content_align",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "content_align_mobile",
      "label": "Alignment - mobile",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "content_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "content_padding_vertical",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding vertical",
      "default": 32,
      "visible_if": "{{ section.settings.content_advanced }}"
    },
    {
      "type": "range",
      "id": "content_padding_vertical_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding vertical - mobile",
      "default": 24,
      "visible_if": "{{ section.settings.content_advanced }}"
    },
    {
      "type": "range",
      "id": "content_padding_horizontal",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding horizontal",
      "default": 28,
      "visible_if": "{{ section.settings.content_advanced }}"
    },
    {
      "type": "range",
      "id": "content_padding_horizontal_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding horizontal - mobile",
      "default": 20,
      "visible_if": "{{ section.settings.content_advanced }}"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Opacity",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "overlay_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Height",
      "default": 70
    },
    {
      "type": "header",
      "content": "Video trigger"
    },
    {
      "type": "range",
      "id": "video_trigger_size",
      "min": 40,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "video_trigger_size_mobile",
      "min": 32,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Size - mobile",
      "default": 52
    },
    {
      "type": "color",
      "id": "video_trigger_bg",
      "label": "Background",
      "default": "rgba(255,255,255,0.15)"
    },
    {
      "type": "color",
      "id": "video_trigger_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "video_trigger_border_color",
      "label": "Border color",
      "default": "rgba(255,255,255,0.4)"
    },
    {
      "type": "range",
      "id": "video_trigger_border_thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    },
    {
      "type": "range",
      "id": "video_close_size",
      "min": 28,
      "max": 56,
      "step": 4,
      "unit": "px",
      "label": "Close button size",
      "default": 36
    },
    {
      "type": "header",
      "content": "Video title"
    },
    {
      "type": "checkbox",
      "id": "video_title_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "video_title_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.video_title_custom }}"
    },
    {
      "type": "range",
      "id": "video_title_size",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 20
    },
    {
      "type": "range",
      "id": "video_title_size_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 18
    },
    {
      "type": "range",
      "id": "video_title_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Line height",
      "default": 130
    },
    {
      "type": "range",
      "id": "video_title_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom offset",
      "default": 65
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "checkbox",
      "id": "title_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.title_custom }}"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Line height",
      "default": 130
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "checkbox",
      "id": "text_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.text_custom }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "text_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "text_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Line height",
      "default": 150,
      "visible_if": "{{ section.settings.text_advanced }}"
    },
    {
      "type": "range",
      "id": "text_mt",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margin top",
      "default": 10,
      "visible_if": "{{ section.settings.text_advanced }}"
    },
    {
      "type": "range",
      "id": "text_mt_mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Margin top - mobile",
      "default": 8,
      "visible_if": "{{ section.settings.text_advanced }}"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "select",
      "id": "features_icon",
      "label": "Icon",
      "default": "check",
      "options": [
        { "label": "Checkmark", "value": "check" },
        { "label": "Dot", "value": "dot" },
        { "label": "None", "value": "none" }
      ]
    },
    {
      "type": "checkbox",
      "id": "features_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "features_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.features_custom }}"
    },
    {
      "type": "range",
      "id": "features_size",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 15
    },
    {
      "type": "range",
      "id": "features_size_mobile",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "features_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "features_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Line height",
      "default": 150,
      "visible_if": "{{ section.settings.features_advanced }}"
    },
    {
      "type": "range",
      "id": "features_mt",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margin top",
      "default": 14,
      "visible_if": "{{ section.settings.features_advanced }}"
    },
    {
      "type": "range",
      "id": "features_mt_mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Margin top - mobile",
      "default": 12,
      "visible_if": "{{ section.settings.features_advanced }}"
    },
    {
      "type": "range",
      "id": "features_gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Gap between features",
      "default": 10,
      "visible_if": "{{ section.settings.features_advanced }}"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "default": "outline",
      "options": [
        { "label": "Link", "value": "link" },
        { "label": "Non-outline", "value": "non_outline" },
        { "label": "Non-outline & arrow", "value": "non_outline_arrow" },
        { "label": "Outline", "value": "outline" },
        { "label": "Outline & arrow", "value": "outline_arrow" }
      ]
    },
    {
      "type": "checkbox",
      "id": "button_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.button_custom }}"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_size_mobile",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "button_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "button_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Line height",
      "default": 150,
      "visible_if": "{{ section.settings.button_advanced }}"
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding horizontal",
      "default": 28,
      "visible_if": "{{ section.settings.button_style != 'link' and section.settings.button_advanced }}"
    },
    {
      "type": "range",
      "id": "button_padding_horizontal_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding horizontal - mobile",
      "default": 24,
      "visible_if": "{{ section.settings.button_style != 'link' and section.settings.button_advanced }}"
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding vertical",
      "default": 14,
      "visible_if": "{{ section.settings.button_style != 'link' and section.settings.button_advanced }}"
    },
    {
      "type": "range",
      "id": "button_padding_vertical_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding vertical - mobile",
      "default": 12,
      "visible_if": "{{ section.settings.button_style != 'link' and section.settings.button_advanced }}"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Roundness",
      "default": 100,
      "visible_if": "{{ section.settings.button_style != 'link' }}"
    },
    {
      "type": "range",
      "id": "button_border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1,
      "visible_if": "{{ section.settings.button_style == 'outline' or section.settings.button_style == 'outline_arrow' }}"
    },
    {
      "type": "range",
      "id": "button_mt",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margin top",
      "default": 20,
      "visible_if": "{{ section.settings.button_advanced }}"
    },
    {
      "type": "range",
      "id": "button_mt_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margin top - mobile",
      "default": 16,
      "visible_if": "{{ section.settings.button_advanced }}"
    },
    {
      "type": "header",
      "content": "Hover panel"
    },
    {
      "type": "color",
      "id": "hover_bg_color",
      "label": "Background",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Text colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "features_color",
      "label": "Features",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "features_icon_color",
      "label": "Features icon",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "video_title_color",
      "label": "Video title",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button colors"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Text hover",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background",
      "default": "rgba(18,18,18,0)"
    },
    {
      "type": "color",
      "id": "button_bg_hover_color",
      "label": "Background hover",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_border_hover_color",
      "label": "Border hover",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Arrow colors",
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}"
    },
    {
      "type": "color",
      "label": "Icon",
