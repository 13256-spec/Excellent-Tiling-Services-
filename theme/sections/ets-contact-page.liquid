{%- comment -%} ETS Visit us / contact page with Shopify Forms app block and native fallback. {%- endcomment -%}
<section class="ets-visit">
  <div class="ets-visit__wrap">
    <header class="ets-visit__head">
      {%- render 'ets-breadcrumbs', current_title: page.title, current_url: request.path -%}
      <p class="ets-overline">Maddington, Western Australia</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.intro | escape }}</p>
    </header>

    <div class="ets-visit__grid">
      <aside class="ets-visit__info">
        <div class="ets-visit__card">
          <dl class="ets-visit__list">
            <div><dt>Address</dt><dd><address>{% render 'ets-address-link', text: '17A Olga Road<br>Maddington WA 6109' %}</address></dd></div>
            <div><dt>Hours</dt><dd>By appointment only<br>Monday to Saturday, 4:30 pm to 9 pm<br>Closed Sunday</dd></div>
            <div><dt>Phone</dt><dd><a href="tel:+61450960543">0450 960 543</a></dd></div>
            <div><dt>Email</dt><dd><a href="mailto:contactus@excellenttilingservice.com.au">contactus@excellenttilingservice.com.au</a></dd></div>
          </dl>
          <p class="ets-visit__note">{{ section.settings.visit_note | escape }}</p>
          <div class="ets-visit__actions">
            <a class="ets-visit__btn" href="{{ pages['book-appointment'].url | default: pages['contact'].url }}">Book a visit</a>
            <a class="ets-visit__btn ets-visit__btn--ghost" href="https://www.google.com/maps/search/?api=1&query=17A+Olga+Road+Maddington+WA+6109" target="_blank" rel="noopener">Get directions</a>
            <a class="ets-visit__btn ets-visit__btn--ghost" href="tel:+61450960543">Call us</a>
          </div>
        </div>
        {%- if section.settings.show_map -%}
          <div class="ets-visit__map">
            <iframe src="https://www.google.com/maps?q=17A+Olga+Road,+Maddington+WA+6109&output=embed" title="Map of the ETS showroom at 17A Olga Road, Maddington" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        {%- endif -%}
      </aside>

      <div class="ets-visit__form">
        <h2>{{ section.settings.form_heading | escape }}</h2>
        <p class="ets-visit__form-intro">{{ section.settings.form_text | escape }}</p>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {% render block %}
          {%- endfor -%}
        {%- else -%}
          {%- form 'contact', class: 'ets-visit__native' -%}
            {%- if form.posted_successfully? -%}
              <p class="ets-visit__success" role="status">Thanks, your message has been sent. We'll be in touch soon.</p>
            {%- endif -%}
            {%- if form.errors -%}<div role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="ets-visit__fields">
              <label>Full name<input name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></label>
              <label>Email<input type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></label>
              <label>Phone<input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}"></label>
              <label>I need help with<select name="contact[Department]"><option>Tiles</option><option>Vanities, basins &amp; baths</option><option>Tapware, showers &amp; accessories</option><option>Renovation or tiling job</option><option>Trade account</option><option>Existing order</option><option>Other</option></select></label>
              <label class="ets-visit__full">Your message<textarea name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea></label>
            </div>
            <button class="ets-visit__btn" type="submit">Send message</button>
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>

    <div class="ets-visit__project">
      <div>
        <h2>Planning a bigger project?</h2>
        <p>Share the scope, location and timing and we'll help with supply or professional tiling.</p>
      </div>
      <a class="ets-visit__btn ets-visit__btn--light" href="{{ pages['request-a-quote'].url }}">Request a quote</a>
    </div>
  </div>
</section>

{% stylesheet %}
.ets-visit { padding: 56px 0 72px; color: var(--ets-ink); }
.ets-visit__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
.ets-visit__head { max-width: 640px; margin-bottom: 40px; }
.ets-visit__head h1 { font-size: clamp(34px, 5vw, 52px); line-height: 1.08; margin: 8px 0 14px; color: var(--ets-ink); }
.ets-visit__head p:last-child { margin: 0; color: var(--ets-muted); font-size: 17px; line-height: 1.6; }
.ets-visit__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 28px; align-items: start; }
.ets-visit__card, .ets-visit__form { background: #FFFFFF; border: 1px solid rgba(21,33,58,.16); border-radius: 20px; padding: 32px; }
.ets-visit__list { margin: 0; display: grid; gap: 18px; }
.ets-visit__list > div { display: grid; grid-template-columns: 76px 1fr; gap: 12px; }
.ets-visit__list dt { font-size: 14px; color: var(--ets-muted); }
.ets-visit__list dd { margin: 0; font-weight: 500; overflow-wrap: anywhere; }
.ets-visit__list address { font-style: normal; line-height: 1.5; }
.ets-visit a { color: var(--ets-ink); }
.ets-visit a:focus-visible, .ets-visit button:focus-visible, .ets-visit input:focus-visible, .ets-visit select:focus-visible, .ets-visit textarea:focus-visible { outline: 2px solid var(--ets-ink); outline-offset: 2px; }
.ets-visit__note { margin: 22px 0; padding-top: 18px; border-top: 1px solid rgba(21,33,58,.16); font-size: 14px; line-height: 1.55; color: var(--ets-muted); }
.ets-visit__actions { display: flex; flex-wrap: wrap; gap: 10px; }
.ets-visit__btn { display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--ets-ink); border-radius: 100px; background: var(--ets-ink); color: #FFFFFF !important; font: inherit; font-size: 15px; font-weight: 600; padding: 12px 22px; text-decoration: none; cursor: pointer; }
.ets-visit__btn:hover { background: #24324D; }
.ets-visit__btn--ghost { background: transparent; color: var(--ets-ink) !important; }
.ets-visit__btn--ghost:hover { background: var(--ets-bg); }
.ets-visit__btn--light { background: var(--ets-bg); border-color: var(--ets-bg); color: var(--ets-ink) !important; }
.ets-visit__btn--light:hover { background: #FFFFFF; }
.ets-visit__map { margin-top: 16px; border-radius: 20px; overflow: hidden; border: 1px solid rgba(21,33,58,.16); aspect-ratio: 4 / 3; background: #E9E5DC; }
.ets-visit__map iframe { display: block; width: 100%; height: 100%; border: 0; }
.ets-visit__form h2 { font-size: clamp(24px, 3vw, 32px); line-height: 1.15; margin: 0 0 8px; color: var(--ets-ink); }
.ets-visit__form-intro { margin: 0 0 24px; color: var(--ets-muted); }
.ets-visit__fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
.ets-visit__fields label { display: grid; gap: 6px; font-size: 14px; font-weight: 500; }
.ets-visit__fields input, .ets-visit__fields select, .ets-visit__fields textarea { width: 100%; padding: 12px 14px; border: 1px solid rgba(21,33,58,.16); border-radius: 12px; background: #FFFFFF; font: inherit; font-size: 15px; color: var(--ets-ink); }
.ets-visit__full { grid-column: 1 / -1; }
.ets-visit__success { padding: 12px 16px; border-radius: 12px; background: #EAF3EC; color: #1E5A31; }
.ets-visit__project { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px 24px; padding: 28px 32px; border-radius: 20px; background: var(--ets-ink); color: var(--ets-bg); }
.ets-visit__project h2 { font-size: 22px; margin: 0; color: inherit; }
.ets-visit__project p { margin: 4px 0 0; opacity: 0.8; }
@media (max-width: 899px) {
  .ets-visit__grid { grid-template-columns: 1fr; }
}
@media (max-width: 599px) {
  .ets-visit { padding: 36px 0 48px; }
  .ets-visit__wrap { padding: 0 16px; }
  .ets-visit__card, .ets-visit__form, .ets-visit__project { padding: 22px; }
  .ets-visit__fields { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "ETS visit and contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit our Maddington showroom" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "See tiles, tapware, vanities and accessories in person by appointment, or send us a question and our local team will get back to you." },
    { "type": "textarea", "id": "visit_note", "label": "Visit note", "default": "The showroom is open by appointment only, Monday to Saturday from 4:30 pm to 9 pm. Book a time online or call us, and let us know which products you want to see so we can have them ready." },
    { "type": "checkbox", "id": "show_map", "label": "Show map", "default": true },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us an enquiry" },
    { "type": "textarea", "id": "form_text", "label": "Form text", "default": "Tell us what you're after and we'll reply by email or phone." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "ETS visit and contact" }]
}
{% endschema %}
