<section class="ets-retail-section ets-retail-support"><div class="ets-container ets-support-grid"><div class="ets-support-intro"><p class="ets-overline">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="ets-btn" href="{{ pages['request-a-quote'].url }}">Talk about your project {% render 'ets-store-icon', name: 'arrow' %}</a></div><div class="ets-support-questions">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}<a class="ets-link" href="{{ pages['contact'].url }}">Showroom & contact details {% render 'ets-store-icon', name: 'arrow' %}</a></div></div></section>
{% schema %}
{
  "name": "ETS project help",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Local knowledge. Practical help."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choosing for a whole project?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Start with your plans, measurements or a few ideas. Our Maddington team can help you work through product selections and professional tiling."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ETS project help"
    }
  ]
}
{% endschema %}
