{% liquid
 assign collection_image = collection.image | default: collection.products.first.featured_image
 assign department = 'Bathroom & accessories'
 assign hardware_handles = 'hardware,trowels-tiling-tools,diamond-blades-drill-bits,tile-spacers-wedges,silicone-additives-cleaners' | split: ','
 if hardware_handles contains collection.handle
  assign department = 'Renovation essentials'
 elsif collection.handle == 'tiles'
  assign department = 'Surfaces & materials'
 endif
%}
<section class="ets-collection-banner"><div class="ets-container"><nav class="ets-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><a href="{{ routes.collections_url }}">Departments</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav><div class="ets-collection-banner-grid"><div><p class="ets-overline">{{ department }}</p><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="ets-collection-description rte">{{ collection.description }}</div>{% endif %}{% if collection.products_count > 0 %}<p class="ets-section-note">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>{% else %}<p class="ets-collection-advice">Looking for something specific? Talk to our Maddington team about the range, availability and your project.</p><div class="ets-button-row"><a class="ets-btn" href="{{ pages['request-a-quote'].url }}?department={{ collection.title | url_encode }}">Enquire about {{ collection.title | downcase | escape }} {% render 'ets-store-icon', name: 'arrow' %}</a><a class="ets-link" href="tel:+61450960543">0450 960 543</a></div>{% endif %}</div>{% if collection_image != blank %}<div class="ets-collection-banner-image">{{ collection_image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 30vw, 60vw', loading: 'eager' }}</div>{% endif %}</div>
{% if collection.handle == 'accessories' or collection.handle == 'tapware' or collection.handle == 'bathroom-vanities' or hardware_handles contains collection.handle %}<nav class="ets-category-tabs" aria-label="Related categories">{% if collection.handle == 'accessories' %}{% assign handles = 'accessories,towel-rails,bathroom-hooks,toilet-roll-holders,soap-shelf-holders' | split: ',' %}{% elsif hardware_handles contains collection.handle %}{% assign handles = hardware_handles %}{% elsif collection.handle == 'tapware' %}{% assign handles = 'tapware,basin-mixers,wall-mixers,shower-tapware,kitchen-tapware' | split: ',' %}{% else %}{% assign handles = 'bathroom-vanities,single-vanities,double-vanities,wall-hung-vanities' | split: ',' %}{% endif %}{% for handle in handles %}{% assign item = collections[handle] %}{% if item != blank %}{% unless item.products_count == 0 and hardware_handles contains item.handle %}<a href="{{ item.url }}"{% if item.handle == collection.handle %} aria-current="page"{% endif %}>{% if item.handle == 'hardware' %}All hardware{% else %}{{ item.title | escape }}{% endif %}</a>{% endunless %}{% endif %}{% endfor %}</nav>{% endif %}
</div></section>
{% schema %}
{
  "name": "ETS collection intro",
  "settings": []
}
{% endschema %}
