{%- comment -%}
  Collection header. Sibling "chips" come from the main menu: if this collection is a
  top-level menu item (or one of its children), the chips list that item's child links.
{%- endcomment -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
  assign group = blank
  for link in menu.links
    if link.url == collection.url
      assign group = link
    endif
    for child in link.links
      if child.url == collection.url
        assign group = link
      endif
    endfor
  endfor
  assign hero_img = collection.image
  assign contain = true
  if hero_img == blank
    assign hero_img = collection.products.first.featured_image
  endif
  assign hero_alt = hero_img.alt | default: collection.title
  if collection.products.first.type == 'Tile'
    assign contain = false
  endif
-%}
<section class="ets ets-phero" aria-labelledby="EtsColl-{{ section.id }}">
  <div class="ets-wrap">
    {%- liquid
      assign crumb_parent_title = ''
      assign crumb_parent_url = ''
      if group != blank and group.url != collection.url
        assign crumb_parent_title = group.title
        assign crumb_parent_url = group.url
      endif
      render 'ets-breadcrumbs', parent_title: crumb_parent_title, parent_url: crumb_parent_url, current_title: collection.title, current_url: collection.url
    -%}
    <div class="ets-phero__grid">
      <div>
        <h1 class="ets-display" id="EtsColl-{{ section.id }}">{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}
          <div class="ets-lede ets-coll-lede">{{ collection.description | strip_html | truncatewords: 45 }}</div>
        {%- endif -%}
        <p class="ets-small" style="margin:16px 0 0">
          {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
          {%- if collection.products.first.type == 'Tile' %} · priced per m² · Perth metro delivery or Maddington pickup{% endif -%}
        </p>
      </div>
      {%- if hero_img != blank and section.settings.show_image -%}
        <div class="ets-phero__media ets-coll-media{% if contain %} ets-phero__media--contain{% endif %}" style="max-width:520px;justify-self:end;width:100%">
          <div class="ets-shell"><div class="ets-core" style="aspect-ratio:16/10">
            {{ hero_img | image_url: width: 1000 | image_tag: loading: 'eager', widths: '400, 700, 1000', sizes: '(min-width: 990px) 36vw, 100vw', alt: hero_alt }}
          </div></div>
        </div>
      {%- endif -%}
    </div>
    {%- if group != blank and group.links.size > 0 -%}
      {%- comment -%}
        Menu child links are sorted into shortcut rows by their wording: "600 x 600 mm" → Size,
        "Matt finish" / "Anti-slip" → Finish, "Morgan range" → Range. Anything else (e.g. vanity
        types) stays in one unlabelled row, so other departments look as before.
      {%- endcomment -%}
      {%- capture chips_size -%}{%- endcapture -%}
      {%- capture chips_finish -%}{%- endcapture -%}
      {%- capture chips_range -%}{%- endcapture -%}
      {%- capture chips_other -%}{%- endcapture -%}
      {%- for child in group.links -%}
        {%- assign t = child.title | downcase -%}
        {%- capture chip -%}<a class="ets-chip" href="{{ child.url }}"{% if child.url == collection.url %} aria-current="page"{% endif %}>{{ child.title | remove: ' finish' | remove: ' range' | escape }}{% if child.type == 'collection_link' %}<small>{{ child.object.products_count }}</small>{% endif %}</a>{%- endcapture -%}
        {%- if t contains ' mm' -%}
          {%- capture chips_size -%}{{ chips_size }}{{ chip }}{%- endcapture -%}
        {%- elsif t contains 'finish' or t contains 'anti-slip' -%}
          {%- capture chips_finish -%}{{ chips_finish }}{{ chip }}{%- endcapture -%}
        {%- elsif t contains ' range' -%}
          {%- capture chips_range -%}{{ chips_range }}{{ chip }}{%- endcapture -%}
        {%- else -%}
          {%- capture chips_other -%}{{ chips_other }}{{ chip }}{%- endcapture -%}
        {%- endif -%}
      {%- endfor -%}
      {%- capture chip_all -%}<a class="ets-chip" href="{{ group.url }}"{% if group.url == collection.url %} aria-current="page"{% endif %}>All {{ group.title | downcase | escape }}</a>{%- endcapture -%}
      {%- if chips_size != blank or chips_finish != blank or chips_range != blank -%}
        <nav class="ets-shortcuts" aria-label="Shop {{ group.title | downcase | escape }} by">
          {%- if chips_size != blank -%}<div class="ets-shortcuts__row"><span class="ets-shortcuts__label">Size</span><div class="ets-chips">{{ chip_all }}{{ chips_size }}</div></div>{%- endif -%}
          {%- if chips_finish != blank -%}<div class="ets-shortcuts__row"><span class="ets-shortcuts__label">Finish</span><div class="ets-chips">{{ chips_finish }}</div></div>{%- endif -%}
          {%- if chips_range != blank -%}<div class="ets-shortcuts__row"><span class="ets-shortcuts__label">Range</span><div class="ets-chips">{{ chips_range }}</div></div>{%- endif -%}
          {%- if chips_other != blank -%}<div class="ets-shortcuts__row"><span class="ets-shortcuts__label">More</span><div class="ets-chips">{{ chips_other }}</div></div>{%- endif -%}
        </nav>
      {%- else -%}
        <nav class="ets-chips" aria-label="{{ group.title | escape }} categories">{{ chip_all }}{{ chips_other }}</nav>
      {%- endif -%}
    {%- endif -%}
    {%- unless section.settings.hide_marquee -%}
      <div class="ets-coll-marquee">{% render 'ets-product-marquee', collection: collection, limit: 24 %}</div>
    {%- endunless -%}
  </div>
</section>
{% stylesheet %}
  .ets-shortcuts { display: grid; gap: 10px; margin-top: 28px; }
  .ets-shortcuts__row { display: grid; grid-template-columns: 64px minmax(0, 1fr); align-items: center; gap: 12px; }
  .ets-shortcuts__label { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ets-muted); }
  .ets-shortcuts .ets-chips { margin-top: 0; }
  @media (max-width: 749px) {
    /* Phones: get shoppers to the products fast. The full description stays in the page for search engines. */
    .ets-coll-lede { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .ets-coll-media, .ets-coll-marquee { display: none; }
    .ets-shortcuts__row { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .ets-shortcuts .ets-chips { margin-inline: calc(-1 * var(--ets-gutter)); padding-inline: var(--ets-gutter); }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "ETS collection header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu for category chips", "default": "main-menu" },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "checkbox", "id": "hide_marquee", "label": "Hide moving product strip", "default": false }
  ]
}
{% endschema %}
