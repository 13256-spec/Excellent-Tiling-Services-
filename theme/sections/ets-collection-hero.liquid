{%- comment -%}
  Collection header. Sibling "chips" come from the main menu: if this collection is a
  top-level menu item (or one of its children), the chips list that item's child links.
{%- endcomment -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
  assign group = blank
  for link in menu.links
    if link.url == collection.url
      assign group = link
    endif
    for child in link.links
      if child.url == collection.url
        assign group = link
      endif
    endfor
  endfor
  assign hero_img = collection.image
  assign contain = true
  if hero_img == blank
    assign hero_img = collection.products.first.featured_image
  endif
  if collection.products.first.type == 'Tile'
    assign contain = false
  endif
-%}
<section class="ets ets-phero" aria-labelledby="EtsColl-{{ section.id }}">
  <div class="ets-wrap">
    <ol class="ets-crumbs" role="list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- if group != blank and group.url != collection.url -%}<li><a href="{{ group.url }}">{{ group.title | escape }}</a></li>{%- endif -%}
      <li aria-current="page">{{ collection.title | escape }}</li>
    </ol>
    <div class="ets-phero__grid">
      <div>
        <h1 class="ets-display" id="EtsColl-{{ section.id }}">{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}
          <div class="ets-lede">{{ collection.description | strip_html | truncatewords: 45 }}</div>
        {%- endif -%}
        <p class="ets-small" style="margin:16px 0 0">
          {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
          {%- if collection.products.first.type == 'Tile' %} · priced per m² · Perth metro delivery or Maddington pickup{% endif -%}
        </p>
      </div>
      {%- if hero_img != blank and section.settings.show_image -%}
        <div class="ets-phero__media{% if contain %} ets-phero__media--contain{% endif %}" style="max-width:520px;justify-self:end;width:100%">
          <div class="ets-shell"><div class="ets-core" style="aspect-ratio:16/10">
            {{ hero_img | image_url: width: 1000 | image_tag: loading: 'eager', widths: '400, 700, 1000', sizes: '(min-width: 990px) 36vw, 100vw', alt: '' }}
          </div></div>
        </div>
      {%- endif -%}
    </div>
    {%- if group != blank and group.links.size > 0 -%}
      <nav class="ets-chips" aria-label="{{ group.title | escape }} categories">
        <a class="ets-chip" href="{{ group.url }}"{% if group.url == collection.url %} aria-current="page"{% endif %}>All {{ group.title | downcase | escape }}</a>
        {%- for child in group.links -%}
          <a class="ets-chip" href="{{ child.url }}"{% if child.url == collection.url %} aria-current="page"{% endif %}>{{ child.title | escape }}{% if child.type == 'collection_link' %}<small>{{ child.object.products_count }}</small>{% endif %}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
    {%- unless section.settings.hide_marquee -%}
      {% render 'ets-product-marquee', collection: collection, limit: 24 %}
    {%- endunless -%}
  </div>
</section>
{% schema %}
{
  "name": "ETS collection header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu for category chips", "default": "main-menu" },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "checkbox", "id": "hide_marquee", "label": "Hide moving product strip", "default": false }
  ]
}
{% endschema %}
