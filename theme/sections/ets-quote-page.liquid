{%- comment -%}
  Project / renovation quote request. Uses Shopify's native contact form (emailed to the
  store). Adding an app block (e.g. Shopify Forms) in the theme editor replaces the form.
{%- endcomment -%}
<section class="ets">
  <div class="ets-phero">
    <div class="ets-wrap">
      {%- render 'ets-breadcrumbs', current_title: 'Request a quote', current_url: request.path -%}
      <p class="ets-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="ets-display">{{ section.settings.heading }}</h1>
      <p class="ets-lede">{{ section.settings.intro | escape }}</p>
    </div>
  </div>
  <div class="ets-sec--tight" style="padding-top:0">
    <div class="ets-wrap ets-form-layout">
      <aside class="ets-form-layout__aside">
        <div class="ets-aside-card ets-shell"><div class="ets-core">
          <h2>What helps us quote</h2>
          <ul class="ets-checks" role="list" style="margin-top:6px">
            <li>{% render 'ets-icon', name: 'check' %}<span>Your suburb and the room(s)</span></li>
            <li>{% render 'ets-icon', name: 'check' %}<span>Rough size — m² or room dimensions</span></li>
            <li>{% render 'ets-icon', name: 'check' %}<span>Products you like from our range</span></li>
            <li>{% render 'ets-icon', name: 'check' %}<span>Photos or plans (email them after submitting)</span></li>
          </ul>
        </div></div>
        <div class="ets-aside-card ets-shell"><div class="ets-core">
          <h3>Rather talk?</h3>
          <dl class="ets-dl">
            <div><dt>Phone</dt><dd><a href="tel:{{ settings.ets_phone_link }}">{{ settings.ets_phone }}</a></dd></div>
            <div><dt>Email</dt><dd><a href="mailto:{{ settings.ets_email }}">{{ settings.ets_email }}</a></dd></div>
            <div><dt>Showroom</dt><dd>{% render 'ets-address-link' %}<br><span class="ets-small">{{ settings.ets_hours | escape }}</span></dd></div>
          </dl>
        </div></div>
      </aside>

      <div class="ets-form-layout__main ets-shell">
        <div class="ets-core">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
          {%- else -%}
            {%- form 'contact', id: 'EtsQuoteForm', class: 'ets-form' -%}
              {%- if form.posted_successfully? -%}
                <div class="ets-alert ets-alert--ok" role="status" tabindex="-1" autofocus>
                  <strong>Thanks — your enquiry has been sent.</strong>
                  We'll review the details and get back to you. Have photos or plans? Email them to <a href="mailto:{{ settings.ets_email }}">{{ settings.ets_email }}</a> with your name.
                </div>
              {%- endif -%}
              {%- if form.errors -%}<div class="ets-alert ets-alert--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
              <input type="hidden" name="contact[Enquiry]" value="Renovation / project quote request">

              <fieldset class="ets-fieldset">
                <legend><span>1</span>The job</legend>
                <div class="ets-field ets-field--full">What do you need? *
                  <div class="ets-options">
                    {%- assign types = 'Bathroom renovation|Kitchen or laundry|Tiling|Waterproofing / leak repair|Products only (supply)|Something else' | split: '|' -%}
                    {%- for t in types -%}
                      <label class="ets-option"><input type="radio" name="contact[Project type]" value="{{ t }}" required{% if forloop.first %} checked{% endif %}><span>{{ t }}</span></label>
                    {%- endfor -%}
                  </div>
                </div>
                <label class="ets-field">Suburb *
                  <input name="contact[Suburb]" autocomplete="address-level2" placeholder="e.g. Gosnells" required>
                </label>
                <label class="ets-field">Approximate size
                  <input name="contact[Approximate size]" placeholder="e.g. 2.4 × 3 m bathroom, or 25 m²">
                </label>
                <label class="ets-field">Timing
                  <select name="contact[Timing]">
                    <option>As soon as possible</option>
                    <option>Within 1–3 months</option>
                    <option>3–6 months</option>
                    <option>Just planning / getting prices</option>
                  </select>
                </label>
                <label class="ets-field">Property
                  <select name="contact[Property]">
                    <option>My home</option>
                    <option>Rental / investment</option>
                    <option>New build</option>
                    <option>Commercial</option>
                  </select>
                </label>
                <label class="ets-field ets-field--full">Tell us about it *
                  <textarea name="contact[body]" rows="6" required placeholder="What's there now, what you'd like, any products you've picked, access, etc."></textarea>
                </label>
              </fieldset>

              <fieldset class="ets-fieldset">
                <legend><span>2</span>Your details</legend>
                <label class="ets-field">Name *<input name="contact[name]" autocomplete="name" required value="{{ customer.name | escape }}"></label>
                <label class="ets-field">Phone *<input type="tel" name="contact[phone]" autocomplete="tel" required></label>
                <label class="ets-field ets-field--full">Email *<input type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required value="{{ customer.email | escape }}"></label>
              </fieldset>

              <div class="ets-btns">
                <button class="ets-btn" type="submit">Send enquiry<span class="ets-btn__dot">{% render 'ets-icon', name: 'arrow' %}</span></button>
                <span class="ets-small">We only use your details to reply to this enquiry.</span>
              </div>
            {%- endform -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ETS quote request",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free measure & quote" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Tell us about your <em>project</em>." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Renovations, tiling, waterproofing or product supply. Send a few details and our family-run team will arrange a free measure and quote." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "ETS quote request" }]
}
{% endschema %}
