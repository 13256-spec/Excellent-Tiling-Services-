{%- comment -%} ETS store footer: newsletter signup, showroom details, two link columns, legal + social row. {%- endcomment -%}
{%- assign ets_instagram_url = section.settings.instagram_url | default: 'https://www.instagram.com/excellent_tiling_services/' -%}
<div class="ets-sf">
  <div class="ets-sf__inner">
    <div class="ets-sf__news">
      <div class="ets-sf__news-copy">
        <h2 class="ets-sf__news-title">{{ section.settings.newsletter_heading | escape }}</h2>
        <p>{{ section.settings.newsletter_text | escape }}</p>
      </div>
      {%- form 'customer', id: 'EtsFooterNewsletter', class: 'ets-sf__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="ets-sf__msg" role="status">Thanks, you're subscribed.</p>
        {%- else -%}
          <label class="ets-sf__sr" for="EtsFooterEmail">Email address</label>
          <div class="ets-sf__field">
            <input id="EtsFooterEmail" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="Email address" autocomplete="email" autocapitalize="off" spellcheck="false" required>
            <button type="submit">Subscribe</button>
          </div>
          {%- if form.errors -%}
            <div class="ets-sf__msg ets-sf__msg--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="ets-sf__main">
      <div class="ets-sf__brand">
        <a class="ets-sf__logo" href="{{ routes.root_url }}" aria-label="Excellent Tiling Services home">
          <img src="https://cdn.shopify.com/s/files/1/0683/0292/9983/files/ets-logo-icon.png?v=1790150823" width="36" height="36" alt="" loading="lazy">
          <span><strong>EXCELLENT</strong><small>TILING SERVICES</small></span>
        </a>
        <p>{{ section.settings.description | escape }}</p>
        {%- if ets_instagram_url != blank or section.settings.facebook_url != blank -%}
          <div class="ets-sf__social">
            {%- if section.settings.facebook_url != blank -%}
              <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 8.5h2V5.2c-.35-.05-1.54-.15-2.94-.15-2.9 0-4.9 1.77-4.9 5.02V13H6.5v3.6h2.66V23h3.7v-6.4h2.78l.44-3.6h-3.22V10.5c0-1.04.28-1.75 1.14-1.75Z"/></svg>
              </a>
            {%- endif -%}
            {%- if ets_instagram_url != blank -%}
              <a href="{{ ets_instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="0.8" fill="currentColor" stroke="none"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="ets-sf__col ets-sf__col--contact">
        <h3>Showroom</h3>
        <address>{{ section.settings.address | escape | newline_to_br }}</address>
        <p class="ets-sf__appt">By appointment · Mon–Sat 4:30–9 pm</p>
        <a href="{{ pages['book-appointment'].url | default: pages['contact'].url }}">Book a showroom visit</a>
        <a href="tel:+61450960543">0450 960 543</a>
        <a href="mailto:contactus@excellenttilingservices.com">contactus@excellenttilingservices.com</a>
      </div>

      <nav class="ets-sf__col" aria-label="Shop">
        <h3>Shop</h3>
        {%- if section.settings.shop_menu != blank -%}
          {%- for link in section.settings.shop_menu.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
        {%- else -%}
          {%- assign handles = 'tiles,hardware,accessories,tapware,bathroom-vanities,mirrors,towel-rails' | split: ',' -%}
          {%- for handle in handles -%}
            {%- assign item = collections[handle] -%}
            {%- if item != blank and item.products_count > 0 -%}<a href="{{ item.url }}">{{ item.title | escape }}</a>{%- endif -%}
          {%- endfor -%}
          <a href="{{ routes.collections_url }}">All departments</a>
        {%- endif -%}
      </nav>

      <nav class="ets-sf__col" aria-label="Help">
        <h3>Help</h3>
        {%- if section.settings.help_menu != blank -%}
          {%- for link in section.settings.help_menu.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
        {%- else -%}
          {%- if pages['book-appointment'] != blank -%}<a href="{{ pages['book-appointment'].url }}">Book a showroom visit</a>{%- endif -%}
          <a href="{{ pages['contact'].url }}">Contact us</a>
          {%- if pages['request-a-quote'] != blank -%}<a href="{{ pages['request-a-quote'].url }}">Request a quote</a>{%- endif -%}
          {%- if pages['tiling-services'] != blank -%}<a href="{{ pages['tiling-services'].url }}">Professional tiling</a>{%- endif -%}
          {%- if pages['delivery-pickup'] != blank -%}<a href="{{ pages['delivery-pickup'].url }}">Delivery & pickup</a>{%- endif -%}
          {%- if shop.shipping_policy != blank -%}<a href="{{ shop.shipping_policy.url }}">Shipping policy</a>{%- endif -%}
          {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">Returns & refunds</a>{%- endif -%}
          {%- if pages['product-care'] != blank -%}<a href="{{ pages['product-care'].url }}">Care & warranty</a>{%- endif -%}
          {%- if pages['faqs'] != blank -%}<a href="{{ pages['faqs'].url }}">FAQs</a>{%- endif -%}
        {%- endif -%}
      </nav>
    </div>

    <div class="ets-sf__bottom">
      <p>© {{ 'now' | date: '%Y' }} Excellent Tiling Services Pty Ltd. ABN 63 150 082 054</p>
      <nav aria-label="Legal">
        {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- endif -%}
        {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- endif -%}
      </nav>
    </div>
  </div>
</div>

{% stylesheet %}
.ets-sf { background: #1F3153; color: #F5F3EE; }
.ets-sf__appt { margin: 0; font-weight: 600; }
.ets-sf__inner { max-width: 1280px; margin: 0 auto; padding: 56px 24px 28px; }
.ets-sf a { color: inherit; text-decoration: none; }
.ets-sf a:hover { text-decoration: underline; text-underline-offset: 3px; }
.ets-sf a:focus-visible, .ets-sf button:focus-visible { outline: 2px solid #F5F3EE; outline-offset: 3px; }
.ets-sf__news { display: grid; grid-template-columns: 1fr minmax(0, 440px); gap: 20px 48px; align-items: center; padding-bottom: 40px; border-bottom: 1px solid rgba(245, 243, 238, 0.18); }
.ets-sf__news-title { font-size: clamp(22px, 2.4vw, 28px); line-height: 1.2; margin: 0 0 6px; color: inherit; }
.ets-sf__news-copy p { margin: 0; opacity: 0.75; font-size: 15px; }
.ets-sf__field { display: flex; background: #F5F3EE; border-radius: 100px; padding: 4px; }
.ets-sf__field:focus-within { box-shadow: 0 0 0 2px #1F3153, 0 0 0 4px #F5F3EE; }
.ets-sf__field input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 12px 16px; font: inherit; font-size: 15px; color: #1F3153; outline: none; }
.ets-sf__field input::placeholder { color: #56606B; }
.ets-sf__field button { border: 0; border-radius: 100px; background: #1F3153; color: #F5F3EE; font: inherit; font-size: 15px; font-weight: 600; padding: 12px 22px; cursor: pointer; }
.ets-sf__field button:hover { background: #2B4270; }
.ets-sf__msg { margin: 0; font-size: 15px; }
.ets-sf__msg--error { margin-top: 10px; color: #FFC9C9; font-size: 14px; }
.ets-sf__msg--error ul { margin: 0; padding-left: 18px; }
.ets-sf__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.ets-sf__main { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px 40px; padding: 40px 0; }
.ets-sf__logo { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 14px; }
.ets-sf__logo:hover { text-decoration: none; }
.ets-sf__logo img { display: block; height: 36px; width: 36px; object-fit: contain; background: #F5F3EE; border-radius: 10px; padding: 5px; box-sizing: border-box; }
.ets-sf__logo span { display: flex; flex-direction: column; line-height: 1.15; }
.ets-sf__logo strong { font-size: 16px; letter-spacing: 0.08em; }
.ets-sf__logo small { font-size: 10px; letter-spacing: 0.18em; opacity: 0.75; }
.ets-sf__brand p { margin: 0; max-width: 34ch; opacity: 0.75; font-size: 15px; line-height: 1.6; }
.ets-sf__social { display: flex; gap: 10px; margin-top: 16px; }
.ets-sf__social a { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 100px; border: 1px solid rgba(245, 243, 238, 0.35); }
.ets-sf__social a:hover { background: rgba(245, 243, 238, 0.12); text-decoration: none; }
.ets-sf__social svg { width: 17px; height: 17px; }
.ets-sf__col { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; font-size: 15px; }
.ets-sf__col h3 { font-size: 14px; font-weight: 600; margin: 0 0 4px; color: inherit; opacity: 0.6; }
.ets-sf__col address { font-style: normal; line-height: 1.5; }
.ets-sf__col a { overflow-wrap: anywhere; }
.ets-sf__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; padding-top: 24px; border-top: 1px solid rgba(245, 243, 238, 0.18); font-size: 13px; opacity: 0.7; }
.ets-sf__bottom p { margin: 0; }
.ets-sf__bottom nav { display: flex; flex-wrap: wrap; gap: 20px; }
@media (max-width: 989px) {
  .ets-sf__main { grid-template-columns: 1fr 1fr; }
  .ets-sf__brand { grid-column: 1 / -1; }
}
@media (max-width: 749px) {
  .ets-sf__inner { padding: 40px 20px 24px; }
  .ets-sf__news { grid-template-columns: 1fr; }
  .ets-sf__main { gap: 28px 20px; }
  .ets-sf__col--contact { grid-column: 1 / -1; }
  .ets-sf__bottom { flex-direction: column; }
}
@media (max-width: 400px) {
  .ets-sf__field { flex-direction: column; border-radius: 16px; }
  .ets-sf__field button { width: 100%; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "ETS store footer",
  "settings": [
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Stay in the loop" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "New tiles, bathroomware arrivals and the occasional offer. No spam." },
    { "type": "textarea", "id": "description", "label": "Brand description", "default": "Bathroom accessories, hardware and tiles, with professional tiling and a local team to help bring it together." },
    { "type": "textarea", "id": "address", "label": "Showroom address", "default": "17A Olga Road\nMaddington WA 6109" },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "link_list", "id": "shop_menu", "label": "Shop links" },
    { "type": "link_list", "id": "help_menu", "label": "Help links" }
  ],
  "presets": [{ "name": "ETS store footer" }]
}
{% endschema %}
