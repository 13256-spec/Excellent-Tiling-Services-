<section class="ets ets-sec{% case section.settings.bg %}{% when 'sand' %} ets-sec--sand{% when 'white' %} ets-sec--white{% when 'ink' %} ets-sec--ink{% endcase %}" aria-labelledby="EtsSvc-{{ section.id }}">
  <div class="ets-wrap">
    <div class="ets-head">
      <div data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="ets-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="ets-h2" id="EtsSvc-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="ets-lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="ets-link" href="{{ section.settings.link | default: '/pages/request-a-quote' }}" data-reveal>{{ section.settings.link_label | escape }} {% render 'ets-icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="ets-services" style="--cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }}">
      {%- for block in section.blocks -%}
        {%- assign bullets = block.settings.bullets | newline_to_br | split: '<br />' -%}
        <article class="ets-service ets-shell" {{ block.shopify_attributes }} data-reveal style="--d:{{ forloop.index0 | times: 0.06 }}s">
          <div class="ets-core">
            {%- if block.settings.image != blank -%}
              <div class="ets-service__img">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1100px) 25vw, (min-width: 600px) 50vw, 100vw', alt: '' }}</div>
            {%- else -%}
              <span class="ets-service__icon">{% render 'ets-icon', name: block.settings.icon %}</span>
            {%- endif -%}
            <div class="ets-service__body">
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
              {%- if block.settings.bullets != blank -%}
                <ul role="list">{%- for b in bullets -%}{%- assign t = b | strip -%}{%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}<a class="ets-link" href="{{ block.settings.link | default: '/pages/request-a-quote' }}">{{ block.settings.link_label | escape }} {% render 'ets-icon', name: 'arrow' %}</a>{%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ETS services",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Renovation services" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "From strip-out to the <em>final grout line</em>." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Request a quote" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "bg", "label": "Background", "default": "none", "options": [{ "value": "none", "label": "Stone" }, { "value": "sand", "label": "Sand" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Dark" }] }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "bath", "options": [{ "value": "bath", "label": "Bath" }, { "value": "kitchen", "label": "Kitchen" }, { "value": "tile", "label": "Tiles" }, { "value": "drop", "label": "Waterproofing" }, { "value": "tools", "label": "Tools" }, { "value": "ruler", "label": "Measure" }, { "value": "shield", "label": "Shield" }] },
        { "type": "image_picker", "id": "image", "label": "Image (replaces icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Bathroom renovations" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "textarea", "id": "bullets", "label": "Bullet points (one per line)" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "ETS services", "blocks": [{ "type": "service" }, { "type": "service" }, { "type": "service" }] }]
}
{% endschema %}
