{% assign hero_image = section.settings.image | default: collections['bathroom-vanities'].image %}
<section class="ets-retail-hero">
  <div class="ets-container ets-retail-hero-grid">
    <div class="ets-retail-hero-copy"><p class="ets-overline">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape | newline_to_br }}</h1><p class="ets-retail-lead">{{ section.settings.description | escape }}</p><div class="ets-button-row"><a class="ets-btn" href="{{ collections['accessories'].url }}">Shop bathroom accessories {% render 'ets-store-icon', name: 'arrow' %}</a><a class="ets-link" href="{{ routes.collections_url }}">Explore all departments <span aria-hidden="true">↗</span></a></div><div class="ets-retail-local">{% render 'ets-store-icon', name: 'pin' %}<span>Maddington showroom<br><strong>17A Olga Road, Maddington WA</strong></span></div></div>
    {% if hero_image != blank %}<figure class="ets-retail-hero-image">{{ hero_image | image_url: width: 1800 | image_tag: widths: '480, 750, 1000, 1400, 1800', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high' }}{% if section.settings.caption != blank %}<figcaption>{{ section.settings.caption | escape }}</figcaption>{% endif %}</figure>{% endif %}
  </div>
  <nav class="ets-department-bar ets-container" aria-label="Shop by department"><a href="{{ collections['accessories'].url }}"><span>01</span><strong>Bathroom accessories</strong>{% render 'ets-store-icon', name: 'arrow' %}</a>{%- if collections['hardware'].products_count > 0 -%}<a href="{{ collections['hardware'].url }}"><span>02</span><strong>Hardware</strong>{% render 'ets-store-icon', name: 'arrow' %}</a><a href="{{ collections['tiles'].url }}"><span>03</span><strong>Tiles</strong>{% render 'ets-store-icon', name: 'arrow' %}</a>{%- else -%}<a href="{{ collections['tiles'].url }}"><span>02</span><strong>Tiles</strong>{% render 'ets-store-icon', name: 'arrow' %}</a><a href="{{ pages['book-appointment'].url | default: pages['contact'].url }}"><span>03</span><strong>Book a showroom visit</strong>{% render 'ets-store-icon', name: 'arrow' %}</a>{%- endif -%}</nav>
</section>
{% schema %}
{
  "name": "ETS retail hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The details. The materials. The whole project."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Bathroom accessories.\nHardware. Tiles."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Bring your space together with bathroom essentials, renovation hardware and tiles. Explore the range or talk through your plans with our Maddington team."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Genuine supplier or showroom image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "MELA BRITTANY · Bathroom collection"
    }
  ],
  "presets": [
    {
      "name": "ETS retail hero"
    }
  ]
}
{% endschema %}
