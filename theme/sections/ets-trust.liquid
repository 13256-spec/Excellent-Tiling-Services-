{%- liquid
  assign since = settings.ets_since
  assign count = 0
-%}
<section class="ets ets-trust" aria-label="Why choose ETS">
  <div class="ets-wrap">
    <ul class="ets-trust__list" role="list">
      {%- if settings.ets_google_rating != blank -%}
        {%- assign count = count | plus: 1 -%}
        <li>
          <span class="ets-trust__icon">{% render 'ets-icon', name: 'star' %}</span>
          <div>
            <strong>{{ settings.ets_google_rating | escape }} on Google</strong>
            <span>{% if settings.ets_google_url != blank %}<a href="{{ settings.ets_google_url }}" target="_blank" rel="noopener">{% endif %}{% if settings.ets_google_count != blank %}{{ settings.ets_google_count | escape }} reviews{% else %}Read our reviews{% endif %}{% if settings.ets_google_url != blank %}</a>{% endif %}</span>
          </div>
        </li>
      {%- endif -%}
      {%- if settings.ets_insured -%}
        {%- assign count = count | plus: 1 -%}
        <li>
          <span class="ets-trust__icon">{% render 'ets-icon', name: 'shield' %}</span>
          <div><strong>Licensed &amp; insured</strong><span>{% if settings.ets_licence != blank %}Licence {{ settings.ets_licence | escape }}{% else %}Bathroom and tiling work{% endif %}</span></div>
        </li>
      {%- endif -%}
      {%- if settings.ets_warranty != blank -%}
        {%- assign count = count | plus: 1 -%}
        <li>
          <span class="ets-trust__icon">{% render 'ets-icon', name: 'medal' %}</span>
          <div><strong>{{ settings.ets_warranty | escape }}</strong><span>On our renovation work</span></div>
        </li>
      {%- endif -%}
      {%- if since != blank -%}
        {%- assign count = count | plus: 1 -%}
        <li>
          <span class="ets-trust__icon">{% render 'ets-icon', name: 'tile' %}</span>
          <div><strong>Tiling Perth since {{ since | escape }}</strong><span>Based in Maddington</span></div>
        </li>
      {%- endif -%}
      {%- if count < 4 -%}
        {%- assign count = count | plus: 1 -%}
        <li>
          <span class="ets-trust__icon">{% render 'ets-icon', name: 'truck' %}</span>
          <div><strong>Australia-wide shipping</strong><span>From $20, free over $1,000</span></div>
        </li>
      {%- endif -%}
      {%- if count < 4 -%}
        <li>
          <span class="ets-trust__icon">{% render 'ets-icon', name: 'briefcase' %}</span>
          <div><strong>Trade accounts</strong><span>Up to 25% off for approved trades</span></div>
        </li>
      {%- endif -%}
    </ul>
  </div>
</section>
{% stylesheet %}
  /* Trust strip: one slim swipeable row on phones instead of a tall 2x2 grid */
@media (max-width: 989px) {
  .ets-trust__list { display: flex; overflow-x: auto; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .ets-trust__list::-webkit-scrollbar { display: none; }
  .ets-trust__list li { flex: 0 0 auto; flex-direction: row; align-items: center; gap: 10px; padding: 14px 18px; border-top: 0; border-left: 1px solid var(--ets-line); scroll-snap-align: start; }
  .ets-trust__list li:first-child { border-left: 0; padding-left: 0; }
  .ets-trust__icon { width: 22px; height: 22px; }
  .ets-trust__icon svg { width: 20px; height: 20px; }
  .ets-trust__list strong { font-size: 14px; white-space: nowrap; }
  .ets-trust__list span { font-size: 12px; white-space: nowrap; margin-top: 1px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "ETS trust strip",
  "settings": [
    { "type": "paragraph", "content": "Shows up to four trust points from Theme settings → ETS business details (Google rating, licence, warranty, years). Empty fields are hidden." }
  ],
  "presets": [{ "name": "ETS trust strip" }]
}
{% endschema %}
