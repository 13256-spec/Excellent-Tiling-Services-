{%- comment -%}
  Full-bleed homepage hero: rotating room photos behind the headline, with a slow zoom,
  a dark gradient for legibility and two buttons. On phones the photo sits above the words
  (new look, 12 Oct 2026).
  Slides are driven by the small inline script below (uses its own [data-ets-hf] hook so it
  doesn't clash with the old hero's slider in ets-2026.js).
{%- endcomment -%}
{%- liquid
  assign tiles_count = collections['tiles'].products_count
  assign all_count = collections.all.products_count
-%}
<section class="ets ets-hf" aria-labelledby="EtsHf-{{ section.id }}">
  <div class="ets-hf__media" data-ets-hf data-interval="{{ section.settings.interval }}">
    {%- for block in section.blocks -%}
      <figure class="ets-hf__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        {%- if block.settings.image != blank -%}
          {%- if forloop.first -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: block.settings.image.alt | default: block.settings.label }}
          {%- else -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: block.settings.image.alt | default: block.settings.label }}
          {%- endif -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <figcaption><a href="{{ block.settings.link | default: routes.all_products_collection_url }}"{% unless forloop.first %} tabindex="-1"{% endunless %}><span>Pictured</span>{{ block.settings.label | escape }}</a></figcaption>
        {%- endif -%}
      </figure>
    {%- endfor -%}
    <div class="ets-hf__shade" aria-hidden="true"></div>
    {%- if section.blocks.size > 1 -%}
      <div class="ets-hf__dots">
        {%- for block in section.blocks -%}
          <button type="button" data-dot="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }} of {{ forloop.length }}"{% if forloop.first %} aria-current="true"{% endif %}><i></i></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="ets-wrap ets-hf__inner">
    <div class="ets-hf__copy">
      <h1 class="ets-hf__title" id="EtsHf-{{ section.id }}">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="ets-hf__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="ets-hf__btns">
        {%- if section.settings.btn_1_label != blank -%}
          <a class="ets-hf__btn ets-hf__btn--solid" href="{{ section.settings.btn_1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn_1_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.btn_2_label != blank -%}
          <a class="ets-hf__btn ets-hf__btn--line" href="{{ section.settings.btn_2_link | default: '/pages/request-a-quote' }}">{{ section.settings.btn_2_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<div class="ets-hf-bar" data-ets-hf-bar hidden>
  <a class="ets-hf-bar__call" href="tel:{{ settings.ets_phone_link | default: '0450960543' }}">{% render 'ets-icon', name: 'phone' %}<span>Call {{ settings.ets_phone | default: '0450 960 543' }}</span></a>
  <a class="ets-hf-bar__quote" href="{{ section.settings.btn_2_link | default: '/pages/request-a-quote' }}">Free quote</a>
</div>

<script>
  (function () {
    var root = document.querySelector("[data-ets-hf]");
    if (!root || root.dataset.etsHfInit) return;
    root.dataset.etsHfInit = '1';
    var slides = root.querySelectorAll('[data-slide]');
    var dots = root.querySelectorAll('[data-dot]');
    if (slides.length < 2) return;
    var i = 0, ms = (parseInt(root.dataset.interval, 10) || 6) * 1000, t;
    function show(n) {
      i = (n + slides.length) % slides.length;
      slides.forEach(function (s, k) {
        var on = k === i;
        s.classList.toggle('is-active', on);
        if (on) { s.removeAttribute('aria-hidden'); } else { s.setAttribute('aria-hidden', 'true'); }
        var a = s.querySelector('a');
        if (a) { if (on) { a.removeAttribute('tabindex'); } else { a.setAttribute('tabindex', '-1'); } }
      });
      dots.forEach(function (d, k) { if (k === i) { d.setAttribute('aria-current', 'true'); } else { d.removeAttribute('aria-current'); } });
    }
    function play() { clearInterval(t); if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) t = setInterval(function () { show(i + 1); }, ms); }
    dots.forEach(function (d) { d.addEventListener('click', function () { show(+d.dataset.dot); play(); }); });
    root.style.setProperty('--ets-hf-ms', ms + 'ms');
    play();
  })();
  (function () {
    var bar = document.querySelector('[data-ets-hf-bar]');
    var hero = document.querySelector('.ets-hf');
    if (!bar || !hero || !('IntersectionObserver' in window)) return;
    bar.hidden = false;
    new IntersectionObserver(function (e) { bar.classList.toggle('is-on', !e[0].isIntersecting); }).observe(hero);
  })();
</script>

{% stylesheet %}
  .ets-hf { position: relative; isolation: isolate; color: #fff; background: #111B30; overflow: hidden;
    min-height: min(74svh, 700px); display: flex; align-items: flex-end; }
  .ets-hf__media { position: absolute; inset: 0; z-index: -1; }
  .ets-hf__slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.2s ease; }
  .ets-hf__slide.is-active { opacity: 1; }
  .ets-hf__slide img, .ets-hf__slide svg { width: 100%; height: 100%; object-fit: cover; display: block;
    transform: scale(1.06); transition: transform 9s linear; }
  .ets-hf__slide.is-active img { transform: scale(1); }
  .ets-hf__shade { position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(17, 27, 48, .78) 0%, rgba(17, 27, 48, .5) 42%, rgba(17, 27, 48, .06) 75%),
      linear-gradient(0deg, rgba(17, 27, 48, .6) 0%, rgba(17, 27, 48, 0) 45%); }
  .ets-hf__slide figcaption { position: absolute; right: clamp(16px, 4vw, 48px); bottom: clamp(36px, 5vw, 52px); z-index: 2; }
  .ets-hf__slide figcaption a { display: inline-flex; flex-direction: column; gap: 2px; padding: 10px 14px;
    border-left: 2px solid #58A0D8; border-radius: 0 4px 4px 0; background: rgba(17, 27, 48, .6); color: #fff; text-decoration: none;
    font: 500 13px/1.25 var(--ets-sans); }
  .ets-hf__slide figcaption span { font-size: 11px; font-weight: 500; color: #9CC8EE; }
  .ets-hf__slide figcaption a:hover { background: rgba(17, 27, 48, .8); }

  .ets-hf__inner { position: relative; width: 100%; padding-block: clamp(56px, 9vh, 110px) clamp(40px, 5vw, 64px); }
  .ets-hf__copy { max-width: 720px; }
  .ets-hf__title { margin: 0; font: 600 clamp(36px, 4.6vw, 62px)/1.02 var(--ets-sans); letter-spacing: -.03em;
    color: #fff; text-wrap: balance; }
  .ets-hf__text { margin: 18px 0 0; max-width: 50ch; font: 400 clamp(16px, 1.25vw, 18px)/1.55 var(--ets-sans); color: rgba(255, 255, 255, .88); }
  .ets-hf__btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .ets-hf__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 24px;
    border-radius: 4px; font: 600 15px/1 var(--ets-sans); text-decoration: none; transition: background-color .2s, color .2s, transform .1s; }
  .ets-hf__btn:active { transform: translateY(1px); }
  .ets-hf a.ets-hf__btn--solid { background: #2A5DA8; color: #fff; }
  .ets-hf a.ets-hf__btn--solid:hover { background: #214B8A; }
  .ets-hf a.ets-hf__btn--line { color: #fff; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .8); }
  .ets-hf__btn--line:hover { background: rgba(255, 255, 255, .12); }
  .ets-hf__btn:focus-visible, .ets-hf__dots button:focus-visible, .ets-hf__slide a:focus-visible { outline: 2px solid #9CC8EE; outline-offset: 3px; }

  .ets-hf__dots { position: absolute; left: clamp(16px, 4vw, 48px); bottom: 18px; display: flex; gap: 8px; z-index: 3; }
  .ets-hf__dots button { width: 36px; height: 20px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .ets-hf__dots i { display: block; width: 100%; height: 3px; border-radius: 2px; background: rgba(255, 255, 255, .35); overflow: hidden; position: relative; }
  .ets-hf__dots button[aria-current="true"] i::after { content: ""; position: absolute; inset: 0; background: #fff;
    transform-origin: left; animation: ets-hf-bar var(--ets-hf-ms, 6s) linear forwards; }
  @keyframes ets-hf-bar { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .ets-hf-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: rgba(17, 27, 48, .96); box-shadow: 0 -6px 24px rgba(0, 0, 0, .18); transform: translateY(110%); transition: transform .3s ease; }
  .ets-hf-bar.is-on { transform: none; }
  .ets-hf-bar a { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; border-radius: 4px;
    font: 600 15px/1 var(--ets-sans); text-decoration: none; }
  .ets-hf-bar svg { width: 18px; height: 18px; }
  .ets-hf-bar a.ets-hf-bar__call { color: #fff; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .5); }
  .ets-hf-bar a.ets-hf-bar__quote { background: #2A5DA8; color: #fff; }
  @media (min-width: 990px) { .ets-hf-bar { display: none; } }

  @media (max-width: 989px) {
    /* Phones and tablets: the photo sits on top and the words sit on paper underneath, so nothing competes with the photo. */
    .ets-hf { display: block; min-height: 0; background: var(--ets-bg); color: var(--ets-ink); }
    .ets-hf__media { position: relative; z-index: auto; aspect-ratio: 4 / 3; max-height: 62vh; }
    .ets-hf__shade { background: linear-gradient(0deg, rgba(17, 27, 48, .28) 0%, rgba(17, 27, 48, 0) 45%); }
    .ets-hf__slide figcaption { right: 12px; bottom: 12px; }
    .ets-hf__dots { left: 12px; bottom: 10px; }
    .ets-hf__inner { padding: 22px var(--ets-gutter) 26px; }
    .ets-hf__title { font-size: clamp(30px, 7.6vw, 42px); color: var(--ets-ink); }
    .ets-hf__text { margin-top: 12px; font-size: 16px; color: var(--ets-ink-soft); }
    .ets-hf__btns { margin-top: 20px; flex-direction: column; }
    .ets-hf__btn { width: 100%; min-height: 48px; }
    .ets-hf a.ets-hf__btn--line { color: var(--ets-ink); box-shadow: inset 0 0 0 1.5px var(--ets-ink); }
    .ets-hf__btn--line:hover { background: rgba(21, 33, 58, .06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ets-hf__slide, .ets-hf__slide img { transition: none; transform: none; }
    .ets-hf__dots i::after { animation: none; transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ETS hero (full width)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above heading", "default": "Maddington showroom · Perth delivery" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Your bathroom, from the first tile to the last tap." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn_1_label", "label": "Button 1 label", "default": "Shop the range" },
    { "type": "url", "id": "btn_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn_2_label", "label": "Button 2 label", "default": "Get a renovation quote" },
    { "type": "url", "id": "btn_2_link", "label": "Button 2 link" },
    { "type": "text", "id": "stat_3_value", "label": "Third number", "default": "5–25%" },
    { "type": "text", "id": "stat_3_label", "label": "Third number label", "default": "off for trade accounts" },
    { "type": "range", "id": "interval", "label": "Change image every", "min": 4, "max": 15, "step": 1, "unit": "s", "default": 7 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image slide",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (landscape works best)" },
        { "type": "text", "id": "label", "label": "Pictured product", "default": "Morgan porcelain tiles" },
        { "type": "url", "id": "link", "label": "Product or collection link" }
      ]
    }
  ],
  "presets": [{ "name": "ETS hero (full width)" }]
}
{% endschema %}
