<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap">
{{ 'ets-2026.css' | asset_url | stylesheet_tag }}
<section class="ets" style="min-height:100dvh;display:grid;place-items:center;padding:40px 16px;background:var(--ets-bg)">
  <div class="ets-shell" style="max-width:560px;width:100%"><div class="ets-core" style="padding:clamp(28px,5vw,56px);display:grid;gap:18px">
    <span class="ets-logo"><img src="https://cdn.shopify.com/s/files/1/0683/0292/9983/files/ets-logo-icon.png?v=1790150823&width=96" width="40" height="33" alt=""><span class="ets-logo__text"><strong>EXCELLENT</strong><small>TILING SERVICES</small></span></span>
    <h1 class="ets-h2">{{ shop.password_message | default: 'Our new store is almost ready.' }}</h1>
    <p class="ets-lede">Tiles, bathroomware and renovations in Perth. Call <a href="tel:{{ settings.ets_phone_link }}">{{ settings.ets_phone }}</a> in the meantime.</p>
    {%- form 'storefront_password', class: 'ets-form' -%}
      {%- if form.errors -%}<div class="ets-alert ets-alert--err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="ets-field">Store password<input type="password" name="password" autocomplete="current-password" required></label>
      <button class="ets-btn" type="submit">Enter<span class="ets-btn__dot">{% render 'ets-icon', name: 'arrow' %}</span></button>
    {%- endform -%}
  </div></div>
</section>
{% schema %}{"name":"ETS password page","settings":[],"presets":[{"name":"ETS password page"}]}{% endschema %}
