<section class="ets-inspiration">
  <div class="ets-inspiration__shell">
    <div class="ets-inspiration__head">
      <div><p>INSPIRATION</p><h2>Rooms worth slowing down for.</h2></div>
      <div><span>Explore materials, finishes and spaces that help shape a more considered bathroom or renovation.</span><a href="/pages/request-a-quote">Plan a project →</a></div>
    </div>

    <div class="ets-inspiration__mosaic">
      <a class="ets-inspiration__tile ets-inspiration__tile--tall" href="/collections/tiles">
        <img src="{{ 'ets-flagship-walkin-shower.jpg' | file_url }}" width="2400" height="3600" alt="Warm travertine-look walk-in shower with black fixtures" loading="lazy">
        <span><strong>Warm stone</strong><small>Explore tiles →</small></span>
      </a>
      <a class="ets-inspiration__tile" href="/collections/single-vanities">
        <img src="{{ 'ets-flagship-stone-vanity.jpg' | file_url }}" width="2200" height="3300" alt="Stone vanity basin with black tapware" loading="lazy">
        <span><strong>Quiet details</strong><small>Explore vanities →</small></span>
      </a>
      <a class="ets-inspiration__tile" href="/collections/baths">
        <img src="{{ 'ets-flagship-freestanding-bath.jpg' | file_url }}" width="2400" height="2585" alt="Neutral bathroom with freestanding bath" loading="lazy">
        <span><strong>Soft neutrals</strong><small>Explore baths →</small></span>
      </a>
      <a class="ets-inspiration__tile ets-inspiration__tile--wide" href="/pages/tiling-services">
        <img src="{{ 'ets-flagship-tiled-floor.jpg' | file_url }}" width="2400" height="1600" alt="Minimal architectural interior with tiled floor" loading="lazy">
        <span><strong>Surfaces that carry the room</strong><small>Professional tiling →</small></span>
      </a>
    </div>

    <div class="ets-inspiration__project">
      <div class="ets-inspiration__project-media"><img src="{{ 'ets-flagship-renovation-bathroom.jpg' | file_url }}" width="2400" height="1600" alt="Modern renovated bathroom with marble accents and walk-in shower" loading="lazy"></div>
      <div class="ets-inspiration__project-copy"><p>FROM IDEA TO FINISH</p><h2>Bring the whole room together.</h2><span>Bathroomware, tiles and professional tiling can be discussed as one connected project with ETS.</span><div><a href="/pages/request-a-quote">Request a quote</a><a href="/pages/contact">Visit the showroom</a></div></div>
    </div>
  </div>
</section>
{% stylesheet %}.ets-inspiration{background:#f5f3ee;color:#11110f;padding:0 14px clamp(70px,8vw,120px)}.ets-inspiration *{box-sizing:border-box}.ets-inspiration a{color:inherit;text-decoration:none}.ets-inspiration__shell{width:min(100%,1560px);margin:0 auto}.ets-inspiration__head{padding:clamp(70px,8vw,120px) 8px 34px;display:grid;grid-template-columns:1fr .62fr;gap:60px;align-items:end}.ets-inspiration__head p,.ets-inspiration__project-copy>p{margin:0 0 16px;color:#77736b;font-size:11px;letter-spacing:.14em}.ets-inspiration__head h2,.ets-inspiration__project-copy h2{margin:0;font-size:clamp(40px,4.7vw,76px);line-height:.98;letter-spacing:-.048em;font-weight:550}.ets-inspiration__head>div:last-child{display:flex;flex-direction:column;align-items:flex-start;gap:18px}.ets-inspiration__head span{max-width:560px;color:#6c6860;font-size:15px;line-height:1.65}.ets-inspiration__head a{font-size:13px;font-weight:600}.ets-inspiration__mosaic{display:grid;grid-template-columns:1.05fr .95fr .95fr;grid-auto-rows:minmax(300px,36vw);gap:14px}.ets-inspiration__tile{position:relative;overflow:hidden;border-radius:28px;background:#ddd8cf}.ets-inspiration__tile--tall{grid-row:span 2}.ets-inspiration__tile--wide{grid-column:span 2}.ets-inspiration__tile img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .7s cubic-bezier(.2,.6,.2,1)}.ets-inspiration__tile:hover img{transform:scale(1.018)}.ets-inspiration__tile:after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(8,8,7,.65),rgba(8,8,7,0) 50%)}.ets-inspiration__tile>span{position:absolute;z-index:1;left:24px;right:24px;bottom:23px;color:#fff}.ets-inspiration__tile strong{display:block;font-size:20px;font-weight:550}.ets-inspiration__tile small{display:block;margin-top:6px;color:rgba(255,255,255,.7);font-size:12px}.ets-inspiration__project{margin-top:14px;min-height:650px;display:grid;grid-template-columns:1.2fr .8fr;border-radius:30px;overflow:hidden;background:#11110f;color:#fff}.ets-inspiration__project-media img{width:100%;height:100%;object-fit:cover;display:block}.ets-inspiration__project-copy{padding:clamp(38px,6vw,82px);display:flex;flex-direction:column;justify-content:center}.ets-inspiration__project-copy>p{color:rgba(255,255,255,.52)}.ets-inspiration__project-copy>span{max-width:550px;margin:23px 0;color:rgba(255,255,255,.65);font-size:16px;line-height:1.65}.ets-inspiration__project-copy>div{display:flex;flex-wrap:wrap;gap:9px}.ets-inspiration__project-copy a{min-height:48px;padding:0 18px;border:1px solid rgba(255,255,255,.24);border-radius:999px;display:inline-flex;align-items:center;font-size:13px;font-weight:600}.ets-inspiration__project-copy a:first-child{background:#fff;color:#11110f;border-color:#fff}@media(max-width:950px){.ets-inspiration__head{grid-template-columns:1fr;gap:28px}.ets-inspiration__mosaic{grid-template-columns:1fr 1fr;grid-auto-rows:56vw}.ets-inspiration__tile--tall{grid-row:span 1}.ets-inspiration__tile--wide{grid-column:span 2}.ets-inspiration__project{grid-template-columns:1fr}.ets-inspiration__project-media{min-height:55vw}}@media(max-width:600px){.ets-inspiration{padding-left:10px;padding-right:10px}.ets-inspiration__mosaic{grid-template-columns:1fr;grid-auto-rows:125vw}.ets-inspiration__tile--wide{grid-column:auto}.ets-inspiration__project-copy{padding:38px 22px}.ets-inspiration__project-media{min-height:470px}.ets-inspiration__head{padding-top:70px}}{% endstylesheet %}{% schema %}{"name":"ETS inspiration","tag":"section","settings":[],"presets":[{"name":"ETS inspiration"}]}{% endschema %}