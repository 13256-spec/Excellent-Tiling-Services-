{%- liquid
  assign parent = collection
  if parent == blank
    for c in product.collections
      if c.handle != 'all' and c.products_count > 0
        assign parent = c
        break
      endif
    endfor
  endif
-%}
<div class="ets ets-wrap" style="padding-top:20px">
  {% render 'ets-breadcrumbs', parent: parent, current_title: product.title, current_url: product.url %}
</div>
{% schema %}
{
  "name": "ETS breadcrumbs",
  "tag": "div",
  "settings": [],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
