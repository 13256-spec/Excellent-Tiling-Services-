{%- liquid
  assign parent = collection
  if parent == blank
    for c in product.collections
      if c.handle != 'all' and c.products_count > 0
        assign parent = c
        break
      endif
    endfor
  endif
-%}
<nav class="ets ets-wrap" aria-label="Breadcrumb" style="padding-top:20px">
  <ol class="ets-crumbs" role="list" style="margin:0">
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {%- if parent != blank -%}<li><a href="{{ parent.url }}">{{ parent.title | escape }}</a></li>{%- endif -%}
    <li aria-current="page">{{ product.title | escape }}</li>
  </ol>
</nav>
{%- if parent != blank -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | append: '/' | json }}},
  {"@type":"ListItem","position":2,"name":{{ parent.title | json }},"item":{{ shop.url | append: parent.url | json }}},
  {"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ shop.url | append: product.url | json }}}
]}
</script>
{%- endif -%}
{% schema %}
{
  "name": "ETS breadcrumbs",
  "tag": "div",
  "settings": [],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
