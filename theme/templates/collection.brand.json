    "story": {
      "type": "ets-split",
      "settings": {
        "flip": false,
        "bg": "white",
        "eyebrow": "The range",
        "heading": "Designed as a family, <em>finished</em> to last.",
        "text": "<p>Basin mixers, wall mixers, bath spouts and shower sets that share one profile and one set of finishes, so a whole bathroom matches without hunting across brands. Solid brass bodies, ceramic disc cartridges and PVD or electroplated finishes, chosen and checked by the tilers who run this store.</p>",
        "checks": "WaterMark certified and WELS rated, numbers on every page\nFive finishes across every piece\nManufacturer warranty, backed by us in Maddington",
        "btn_1_label": "Shop the suites",
        "btn_1_link": "#suites",
        "btn_2_label": "Book a showroom visit",
        "btn_2_link": "/pages/book-appointment"
      }
    },
    "finishes": {
      "type": "ets-finishes",
      "settings": {
        "eyebrow": "Finishes",
        "heading": "Five finishes, <em>one</em> family.",
        "text": "Every piece in the range comes in the same finishes, so a basin mixer, wall mixer, bath spout and shower always match.",
        "bg": "none"
      },
      "blocks": {
        "chrome": {
          "type": "finish",
          "settings": {
            "name": "Chrome"
          }
        },
        "matt-black": {
          "type": "finish",
          "settings": {
            "name": "Matt Black"
          }
        },
        "brushed-nickel": {
          "type": "finish",
          "settings": {
            "name": "Brushed Nickel"
          }
        },
        "brushed-brass": {
          "type": "finish",
          "settings": {
            "name": "Brushed Brass"
          }
        },
        "gunmetal": {
          "type": "finish",
          "settings": {
            "name": "Gunmetal"
          }
        }
      },
      "block_order": [
        "chrome",
        "matt-black",
        "brushed-nickel",
        "brushed-brass",
        "gunmetal"
      ]
    },
    "suites": {
      "type": "ets-suites",
      "settings": {
        "eyebrow": "Shop the suite",
        "heading": "Matching sets, <em>one</em> finish.",
        "text": "Each suite is a basin mixer, wall mixer, bath spout and shower set designed together. Pick a finish and add the lot in one go.",
        "bg": "white"
      }
    },
    "credentials": {
      "type": "ets-info-cards",
      "settings": {
        "eyebrow": "Compliance and warranty",
        "heading": "The paperwork, <em>on</em> every page.",
        "bg": "none"
      },
      "blocks": {
        "watermark": {
          "type": "card",
          "settings": {
            "icon": "shield",
            "title": "WaterMark certified",
            "text": "<p>Every tap and shower carries its WaterMark licence number and the certifier that issued it. Nothing is listed without one.</p>"
          }
        },
        "wels": {
          "type": "card",
          "settings": {
            "icon": "box",
            "title": "WELS rated",
            "text": "<p>The water rating, flow rate and WELS registration number are on each product page and in the spec table, so you can check them on the WELS register.</p>",
            "link_label": "WELS register",
            "link": "https://www.waterrating.gov.au/"
          }
        },
        "warranty": {
          "type": "card",
          "settings": {
            "icon": "medal",
            "title": "Warranty, handled here",
            "text": "<p>The manufacturer warranty is shown on each product. Claims go through us in Maddington, not a call centre overseas.</p>",
            "link_label": "Care and warranty",
            "link": "/pages/product-care"
          }
        }
      },
      "block_order": [
        "watermark",
        "wels",
        "warranty"
      ]
    },
