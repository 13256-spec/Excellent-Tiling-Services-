    "faq": {
      "type": "ets-faq",
      "settings": {
        "eyebrow": "",
        "heading": "Common questions",
        "text": "",
        "open_first": false,
        "bg": "white"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Where is this tapware made?",
            "answer": "<p>It is made for us by a specialist tapware manufacturer to our specification, and tested to the Australian WaterMark and WELS schemes. Each product page lists its licence and registration numbers.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Will the finishes match other brands?",
            "answer": "<p>Finishes vary between makers, even with the same name. Within this range every piece matches; if you are pairing with another brand, bring it to the showroom and compare in person.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What pressure does it need?",
            "answer": "<p>The maximum working pressure is in each product's spec table. Australian plumbing rules cap new installations at 500 kPa; your plumber can fit a pressure limiting valve if yours is higher.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Do trade accounts get a discount on this range?",
            "answer": "<p>Yes. Approved trade accounts see their price once logged in, and the discount comes off in the cart.</p>",
            "link": ""
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ]
    },
    "cta": {
