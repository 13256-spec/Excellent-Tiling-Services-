      "blocks": {
        "ss-heading-1": {
          "type": "heading",
          "settings": {
            "heading": "<h2>Still missing a piece of the bathroom?</h2>",
            "heading_custom": false,
            "heading_font": "josefin_sans_n4",
            "heading_size": 36,
            "heading_size_mobile": 26,
            "heading_height": 130,
            "heading_mt": 0,
            "heading_mt_mobile": 0,
            "heading_color": "#15213A"
          }
        },
        "ss-text-2": {
          "type": "text",
          "settings": {
            "text": "<p>Stay in this store and keep matching the rest of the wet area — tapware, vanities, storage, and tiling supplies sit under the same roof.</p>",
            "text_custom": false,
            "text_font": "josefin_sans_n4",
            "text_size": 15,
            "text_size_mobile": 14,
            "text_height": 150,
            "text_mt": 30,
            "text_mt_mobile": 20,
            "text_color": "#6A6862"
          }
        },
        "ss-tab-3": {
          "type": "tab",
          "settings": {
            "tab": "The rest of the job"
          }
        },
        "ss-faq_item-4": {
          "type": "faq_item",
          "settings": {
            "question": "What if this line is only one part of the bathroom?",
            "answer": "<p>Keep browsing the same catalogue for tapware, vanities, baths, toilets, basins, storage, adhesives, grout, trims, and tiling tools so the next piece comes from the same AU shop.</p>"
          }
        },
        "ss-faq_item-5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I match accessories and storage after the fixtures?",
            "answer": "<p>Yes. Accessories, mirrors, and bathroom storage sit alongside the fixture collections, so later add-ons can follow the same order path.</p>"
          }
        },
        "ss-tab-6": {
          "type": "tab",
          "settings": {
            "tab": "Before you confirm"
          }
        },
        "ss-faq_item-7": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a separate tiling supplier for grout and trims?",
            "answer": "<p>Adhesives, grout, trims, and tiling tools are listed here with the bathroom fixtures, so install consumables can ride in the same cart.</p>"
          }
        },
        "ss-faq_item-8": {
          "type": "faq_item",
          "settings": {
            "question": "Where do I see trade rates on other lines?",
            "answer": "<p>Open the Trade 5%, 10%, and 15% collections to review eligible stock. Rates apply to those collections rather than every item in the store.</p>"
          }
        }
      },
