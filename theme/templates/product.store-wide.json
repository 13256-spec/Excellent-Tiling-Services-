    "ss-faq-17-5": {
      "type": "ss-faq-17",
      "blocks": {
        "ss-heading-1": {
          "type": "heading",
          "settings": {
            "heading": "<h2>Shipping, showroom, and returns</h2>",
            "heading_custom": false,
            "heading_font": "josefin_sans_n4",
            "heading_size": 40,
            "heading_size_mobile": 28,
            "heading_height": 130,
            "heading_mt": 0,
            "heading_mt_mobile": 0,
            "heading_color": "#15213A"
          }
        },
        "ss-text-2": {
          "type": "text",
          "settings": {
            "text": "<p>Orders are packed for Australian sites and homes. Selected lines can be seen at the Maddington showroom before you commit.</p>",
            "text_custom": false,
            "text_font": "josefin_sans_n4",
            "text_size": 16,
            "text_size_mobile": 14,
            "text_height": 150,
            "text_mt": 30,
            "text_mt_mobile": 20,
            "text_color": "#6A6862"
          }
        },
        "ss-tab-3": {
          "type": "tab",
          "settings": {
            "tab": "Shipping"
          }
        },
        "ss-faq_item-4": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship across Australia?",
            "answer": "<p>Yes. Orders ship within Australia and are packed for both home deliveries and trade sites.</p>"
          }
        },
        "ss-faq_item-5": {
          "type": "faq_item",
          "settings": {
            "question": "Can fixtures and tiling hardware travel on the same order?",
            "answer": "<p>Bathroom fixtures and trade hardware are sold together, so wet-area pieces and install supplies can leave in one shipment when stock allows.</p>"
          }
        },
        "ss-tab-6": {
          "type": "tab",
          "settings": {
            "tab": "Showroom"
          }
        },
        "ss-faq_item-7": {
          "type": "faq_item",
          "settings": {
            "question": "Where can I see finishes in person?",
            "answer": "<p>Selected stock is held at the Maddington showroom, so you can check finishes before you order lines that are available there.</p>"
          }
        },
        "ss-faq_item-8": {
          "type": "faq_item",
          "settings": {
            "question": "Is every line on the floor?",
            "answer": "<p>The showroom backs many lines; availability on the floor varies. Use the catalogue for the full range of fixtures and tiling supplies, then confirm showroom stock when you need to see a finish.</p>"
          }
        },
        "ss-tab-9": {
          "type": "tab",
          "settings": {
            "tab": "Returns"
          }
        },
        "ss-faq_item-10": {
          "type": "faq_item",
          "settings": {
            "question": "What if a piece is unused after delivery?",
            "answer": "<p>Unused items follow the store’s returns path. Keep original packing and contact the team so the order can be checked against the listed return terms.</p>"
          }
        },
        "ss-faq_item-11": {
          "type": "faq_item",
          "settings": {
            "question": "Who do I speak to about a mixed fixture and hardware order?",
            "answer": "<p>The same team handles bathroom fixtures and trade hardware. Reach out with your order details and they will sort shipping or return questions for the full mix.</p>"
          }
        }
      },
