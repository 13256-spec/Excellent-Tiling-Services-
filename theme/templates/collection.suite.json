        "q1": {
          "type": "question",
          "settings": {
            "question": "Do the finishes match across the suite?",
            "answer": "<p>Yes. Every piece in a suite is made in the same finish from the same manufacturer batch process, so a basin mixer, wall mixer, bath spout and shower set bought together match.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Is the tapware WaterMark certified and WELS rated?",
            "answer": "<p>Every product page shows its WaterMark licence number and WELS registration and star rating. We do not list a tap or shower without them.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Can I buy one piece now and the rest later?",
            "answer": "<p>Yes. Each piece is sold on its own as well as in the suite. Keep the finish name from your order so the next piece matches.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Who should install it?",
            "answer": "<p>A licensed plumber. Installation guides are on each product page under Downloads.</p>"
          }
        }
