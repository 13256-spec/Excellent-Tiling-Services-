{
  "sections": {
    "breadcrumbs": {
      "type": "ets-product-breadcrumbs",
      "settings": {}
    },
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "grid",
            "media_columns": "one",
            "image_gap": 16,
            "large_first_image": true,
            "slideshow_controls_style": "counter",
            "slideshow_mobile_controls_style": "dots",
            "thumbnail_position": "right",
            "thumbnail_width": 44,
            "thumbnail_radius": 0,
            "aspect_ratio": "adapt",
            "constrain_to_viewport": true,
            "media_fit": "contain",
            "media_radius": 0,
            "extend_media": false,
            "zoom": true,
            "video_loop": false,
            "hide_variants": true,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "details_position": "flex-start",
            "gap": 20,
            "sticky_details_desktop": true,
            "background_media": "none",
            "background_color": "",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 28,
            "padding-block-end": 28,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "vendor": {
              "type": "text",
              "settings": {
                "text": "<p>{{ closest.product.vendor }}</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h6",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "title": {
              "type": "text",
              "settings": {
                "text": "<h1>{{ closest.product.title }}</h1>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h2",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": true,
                "type_preset": "h4",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "variant": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": false,
                "variant_style_class": "default",
                "selected_variant_style_class": "default",
                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "calc": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{% render 'ets-pdp-calc', product: product %}"
              },
              "blocks": {}
            },
            "buy": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_pickup_availability": true,
                "gift_card_form": false,
                "input_style": "default",
                "border_width": 1,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {
                    "input_style": "default",
                    "border_width": 1,
                    "border_radius": 0
                  },
                  "blocks": {}
                },
                "add": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  },
                  "blocks": {}
                },
                "checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "trust": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{% render 'ets-pdp-perks', product: product %}"
              },
              "blocks": {}
            },
            "description": {
              "type": "text",
              "settings": {
                "text": "{{ closest.product.description }}",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "trade": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{% render 'ets-pdp-trade' %}"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "vendor",
            "title",
            "price",
            "trade",
            "variant",
            "calc",
            "buy",
            "trust",
            "description"
          ]
        }
      },
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": false,
        "limit_details_width": false,
        "gap": 48,
        "enable_sticky_add_to_cart": true,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 16,
        "padding-block-end": 48
      }
    },
    "specs": {
      "type": "ets-product-specs",
      "settings": {
        "heading": "Details & specifications",
        "show_help": true,
        "help_url": "shopify://pages/contact"
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Complete the look</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h4",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 6,
            "border": "none",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 8,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border": "none",
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "corner_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h5",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "gallery",
            "title",
            "price"
          ]
        }
      },
      "block_order": [
        "heading"
      ],
      "settings": {
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "layout_type": "grid",
        "carousel_on_mobile": true,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 10,
        "rows_gap": 28,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "gap": 28,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 48,
        "padding-block-end": 72
      }
    }
  },
  "order": [
    "breadcrumbs",
    "main",
    "specs",
    "recommendations"
  ]
}