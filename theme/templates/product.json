            "heading_size_mobile": 28,
            "heading_height": 130,
            "heading_mt": 0,
            "heading_mt_mobile": 0,
            "heading_color": "#15213A"
          }
        },
        "ss-text-2": {
          "type": "text",
          "settings": {
            "text": "<p>More answers on our <a href=\"/pages/faqs\">FAQs page</a>, or call 0450 960 543.</p>",
            "text_custom": false,
            "text_font": "josefin_sans_n4",
            "text_size": 15,
            "text_size_mobile": 14,
            "text_height": 150,
            "text_mt": 30,
            "text_mt_mobile": 20,
            "text_color": "#6A6862"
          }
        },
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "Is everything in stock?",
            "answer": "<p>Not always. Some products are ordered in from the supplier. If you need something by a certain date, call us to check before you order.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Do you deliver?",
            "answer": "<p>Tiles and large items are delivered within the Perth metro area, or you can pick up free from Maddington. Small bathroom items like tapware and accessories ship anywhere in Australia from $20, free on orders over $1,000. Delivery options for your address show at checkout.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How much tile should I order?",
            "answer": "<p>Measure the area in square metres and add 10% for cuts and breakages (15–20% for herringbone or diagonal layouts). Every tile page has a calculator that sets the quantity for you.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I pick up my order?",
            "answer": "<p>Yes. Choose pickup at checkout. Wait until we tell you your order is ready, then <a href=\"/pages/book-appointment\">book a pickup time</a> and bring your order number.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return something?",
            "answer": "<p>Change-of-mind returns are accepted within 30 days for unused products in original packaging. A 15% restocking fee applies. Faulty or damaged items are covered under the Australian Consumer Law. See our <a href=\"/policies/refund-policy\">Refund Policy</a>.</p>"
          }
        }
      },
      "block_order": [
        "ss-heading-1",
        "ss-text-2",
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4",
        "faq_5"
      ]
    },
