            "tab": "Products & tiles"
          }
        },
        "q_8": {
          "type": "faq_item",
          "settings": {
            "question": "Is everything in stock?",
            "answer": "<p>Not always. Some products are ordered in from the supplier. If you need something by a certain date, call us to check before you order.</p>"
          }
        },
        "q_9": {
          "type": "faq_item",
          "settings": {
            "question": "How much tile should I order?",
            "answer": "<p>Measure the area in square metres and add 10% for cuts and breakages (15–20% for herringbone or diagonal layouts). Every tile page has a calculator that sets the quantity for you.</p>"
          }
        },
        "q_10": {
          "type": "faq_item",
          "settings": {
            "question": "Where do I find sizes and specs?",
            "answer": "<p>On each product page, under Specifications. If something you need isn't listed, call us and we'll check with the supplier.</p>"
          }
        },
        "q_11": {
          "type": "faq_item",
          "settings": {
            "question": "What warranty do products come with?",
            "answer": "<p>Products come with the manufacturer's warranty, plus your rights under the Australian Consumer Law. See <a href=\"/pages/product-care\">Care &amp; Warranty</a>.</p>"
          }
        },
        "tab_4": {
          "type": "tab",
