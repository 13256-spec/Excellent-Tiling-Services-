        "q_15": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return something?",
            "answer": "<p>Change-of-mind returns are accepted within 30 days of receiving your order for unused products in original packaging. A restocking fee applies. See our <a href=\"/policies/refund-policy\">Refund Policy</a> for the full details.</p>"
          }
        },
        "q_16": {
          "type": "faq_item",
          "settings": {
            "question": "What if something arrives damaged or faulty?",
            "answer": "<p>Contact us with your order number and photos as soon as possible. Faulty, damaged or incorrect products are covered under the Australian Consumer Law, and restocking fees never apply to them. See our <a href=\"/policies/refund-policy\">Refund Policy</a>.</p>"
          }
