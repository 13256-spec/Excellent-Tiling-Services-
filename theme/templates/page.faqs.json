        "q_12": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get a tiling quote?",
            "answer": "<p>Fill in the <a href=\"/pages/request-a-quote\">quote form</a> with your suburb, the type of work, rough size and when you want it done. Or just call us.</p>"
          }
        },
        "q_13": {
          "type": "faq_item",
          "settings": {
            "question": "Do you do the renovation as well as supply?",
            "answer": "<p>Yes. Our team handles full bathroom renovations, kitchen and laundry work, tiling and waterproofing repairs across Perth, starting with a free measure and quote. <a href=\"/pages/tiling-services\">See our services</a>.</p>"
          }
        },
        "q_14": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get trade pricing?",
            "answer": "<p><a href=\"/pages/trade-account\">Apply for a trade account</a> with your ABN and trade details. Once approved, log in with the same email and trade prices show on every product.</p>"
          }
        },
