        "q_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I just drop in to the showroom?",
            "answer": "<p>No, the showroom is open by appointment only. <a href=\"/pages/book-appointment\">Book a showroom visit</a> online or call <a href=\"tel:+61450960543\">0450 960 543</a>. Tell us what you'd like to see so we can have it ready.</p>"
